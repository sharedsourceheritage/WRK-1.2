        const LPSTR prjCATIDMyCPrjProjectBrowseObject = "{6CFF5378-704E-4b6b-A7EF-052AF4ABB477}";     
        
        // Project config browse object CATID.
        // 0x75794057, 0xba6a, 0x491a, 0xaf, 0xbb, 0x23, 0xdc, 0xd1, 0x7b, 0xbe, 0xe3);
