        // File browse object CATID.
        // 0xd8c6a3e3, 0x58a4, 0x45cc, 0x97, 0x70, 0xfb, 0xba, 0x88, 0x66, 0xcd, 0xf9);
        [helpstring("MyCPrj File browse object CATID")]          
        const LPSTR prjCATIDMyCPrjFileBrowseObject =  "{D8C6A3E3-58A4-45cc-9770-FBBA8866CDF9}";                 
    }

