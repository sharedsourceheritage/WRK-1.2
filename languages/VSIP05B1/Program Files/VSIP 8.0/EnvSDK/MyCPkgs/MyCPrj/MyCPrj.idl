    {
        MyCPrjDebugStartMode_Project = 0,
        MyCPrjDebugStartMode_Application,
    } MyCPrjDebugStartMode;
    cpp_quote("#define MyCPrjDebugStartModeMin  MyCPrjDebugStartMode_Project")
    cpp_quote("#define MyCPrjDebugStartModeMax  MyCPrjDebugStartMode_Application")


