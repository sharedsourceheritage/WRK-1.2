import "oaidl.idl";
import "ocidl.idl";
import "vsshell.idl";
cpp_quote("#include \"oleipc.h\"")

#define MEMID_Name            (0x80010000)  // as defined by OLE controls spec.


// this list includes config and project properties.
// if you add new properties, please add config props in the config section and
// project props in the project section.
enum
{
    // project properties
    MyCPrjPROJPROPID_ProjectPath = 1,
    MyCPrjPROJPROPID_IsDirty,
    MyCPrjPROJPROPID_Extender,
    MyCPrjPROJPROPID_ExtenderNames,
    MyCPrjPROJPROPID_ExtenderCATID,

    // project cfg properties
    MyCPrjPROJPROPID_SourceFile,
    MyCPrjPROJPROPID_ProjectType,
    MyCPrjPROJPROPID_OutputPath,
    MyCPrjPROJPROPID_DebugInfoChecked,
    MyCPrjPROJPROPID_ListingFileChecked,
    MyCPrjPROJPROPID_CommandLine,
    MyCPrjPROJPROPID_OutputFile,
    MyCPrjPROJPROPID_DebugStartMode,
    MyCPrjPROJPROPID_StartApp,
    MyCPrjPROJPROPID_StartAppPath,
    MyCPrjPROJPROPID_CustomStartupArguments,
};


enum 
{
    DISPID_MyCPrjSourceFile_FilePath = 1,
    DISPID_MyCPrjSourceFile_IsOutput,
    DISPID_MyCPrjSourceFile_ModifiedDate,
    DISPID_MyCPrjSourceFile_Size,
    DISPID_MyCPrjSourceFile_FileType,
    DISPID_MyCPrjSourceFile_ReadOnly,
    DISPID_MyCPrjSourceFile_Extender,
    DISPID_MyCPrjSourceFile_ExtenderNames,
    DISPID_MyCPrjSourceFile_ExtenderCATID
};


