IDD_APPLYTOALL DIALOG  0, 0, 272, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "<Caption goes here>"
FONT 8, "Tahoma"
BEGIN
    ICON            32515,IDC_STATIC,7,7,20,20,WS_GROUP
    LTEXT           "<Message text goes here>",IDC_MSGTEXT,38,7,227,26,
                    SS_NOPREFIX
    CONTROL         "&Apply to all items",IDC_CHK_APPLYTOALL,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,38,41,227,10
    DEFPUSHBUTTON   "&Yes",IDYES,107,61,50,14
    PUSHBUTTON      "&No",IDNO,161,61,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,215,61,50,14
END

IDD_PP_BUILD DIALOG  0, 0, 248, 158
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Tahoma"
BEGIN
    LTEXT           "Source file:",IDC_STATIC,7,0,37,8
    CONTROL         "Tree1",IDC_SOURCEFILE,"SysTreeView32",TVS_HASBUTTONS | 
                    TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | 
                    WS_BORDER | WS_TABSTOP,7,9,106,76
    LTEXT           "Command line options:",IDC_STATIC,7,113,73,8
    EDITTEXT        IDC_CMDLINE,7,122,236,35,ES_MULTILINE | ES_READONLY | 
                    WS_VSCROLL | NOT WS_TABSTOP
    LTEXT           "Project type:",IDC_STATIC,7,96,43,11
    COMBOBOX        IDC_PROJECTTYPE,55,95,58,44,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT           "Output path:",IDC_STATIC,123,60,43,8
    EDITTEXT        IDC_OUTPUTPATH,123,70,94,14,ES_AUTOHSCROLL
    LTEXT           "Output file:",IDC_STATIC,124,85,38,8
    EDITTEXT        IDC_OUTPUT_FILE,124,95,113,13,ES_AUTOHSCROLL | 
                    ES_READONLY | NOT WS_TABSTOP
    CONTROL         "Generate debug info",IDC_DEBUGCHECK,"Button",
                    BS_AUTO3STATE | WS_TABSTOP,123,9,82,8
    CONTROL         "Generate listing file",IDC_LISTINGCHECK,"Button",
                    BS_AUTO3STATE | WS_TABSTOP,123,36,77,8
    EDITTEXT        IDC_DEBUGNAME,134,20,105,12,ES_AUTOHSCROLL | ES_READONLY | 
                    NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_LISTINGNAME,134,47,105,12,ES_AUTOHSCROLL | 
                    ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    PUSHBUTTON      "...",IDC_OUTPUTPATHBROWSE,219,70,18,14
    GROUPBOX        "Output",IDC_STATIC,118,0,125,113
END

