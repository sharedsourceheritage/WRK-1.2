        [propput, id( VBPROJPROPID_AssemblyTrademark )]
        HRESULT Trademark( [in] BSTR bstrTrademark );

        typedef [uuid(355354DE-E2F0-45d5-9632-4823655C9C95)]
        enum prjAssemblyType
        {
             prjAssemblyType_Library
            ,prjAssemblyType_Platform
        } prjAssemblyType;
    
        cpp_quote("#define prjAssemblyTypeMin  prjAssemblyType_Library")
