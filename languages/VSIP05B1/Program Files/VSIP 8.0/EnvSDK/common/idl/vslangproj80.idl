        [propput, id( VBPROJPROPID_EnableSecurityDebugging )]
        HRESULT EnableSecurityDebugging( [in] VARIANT_BOOL bEnableSecurityDebugging);

        // URL for secure debug
        [propget, id( VBPROJPROPID_SecureDebugURL )]
        HRESULT DebugSecurityZoneURL( [out, retval] BSTR *pbstrSecurityURL);
        [propput, id( VBPROJPROPID_SecureDebugURL )]
        HRESULT DebugSecurityZoneURL( [in] BSTR bstrSecurityURL);

        [propget, nonbrowsable, id(VBPROJPROPID_Publish), helpstring("Publish")]
        HRESULT Publish([out, retval] IDispatch **ppdispPublish);        
        
        [propget, id(VBPROJPROPID_ComVisible), helpstring("COM Visible")]
        HRESULT ComVisible([out, retval] VARIANT_BOOL *pbComVisible); 
        [propput, id(VBPROJPROPID_ComVisible), helpstring("COM Visible")]
