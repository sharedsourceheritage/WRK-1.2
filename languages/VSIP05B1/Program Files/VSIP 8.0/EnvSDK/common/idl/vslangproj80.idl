        [propput, id(VBPROJPROPID_AssemblyOriginatorKeyFileType), helpstring("Assembly Key Originator Key File Type")]
        HRESULT AssemblyOriginatorKeyFileType([in]DWORD dwOriginatorKeyFileType);

        [propget, id(VBPROJPROPID_AssemblyVersion), helpstring("Assembly Version")]
