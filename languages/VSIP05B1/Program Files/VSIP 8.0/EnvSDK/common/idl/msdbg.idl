#ifndef _SHIP
[
	object,
	uuid(86DB55C6-0EAA-4f94-9EA8-E5D858B54DD7),
	pointer_default(unique)
]
interface IDebugProcess3__depricated_86DB55C6: IDebugProcess2
{
	enum enum_EXECUTE_FLAGS
	{
		// Execute all process in the session.
		// May not be combined with EXECUTE_ONLY_THIS_PROCESS.
		EXECUTE_ALL_PROCESSES		= 0x0001,
		// Execute only this process, leaving the other processes
		// in whatever state they are currently in.
		// May not be combined with EXECUTE_ALL_PROCESSES.
		EXECUTE_ONLY_THIS_PROCESS	= 0x0002,
	};
	typedef DWORD EXECUTE_FLAGS;

	// Execute the process. The thread is given so that the debugger
	// knows which thread the user is viewing when executing.
	HRESULT Execute(
		[in] IDebugThread2* pThread,
		[in] EXECUTE_FLAGS dwExecuteFlags);

	// Continue the process in whatever state is was previously in. If
	// the process was stepping, then continue the step; otherwise,
	// continue execution.
	HRESULT Continue(
		[in] IDebugThread2* pThread,
		[in] EXECUTE_FLAGS dwExecuteFlags);

	// Step the process. The thread specified is stepped and all other
	// threads in the process run.
	HRESULT Step(
		[in] IDebugThread2* pThread,
		[in] STEPKIND sk,
		[in] STEPUNIT step,
		[in] EXECUTE_FLAGS dwExecuteFlags);

	HRESULT GetDebugReason(
		[out] DEBUG_REASON *pReason);

	// Dequeue the next stopping event for this process. The event is
	// dequeued synchronously to IDebugEventCallback2::Event and will
	// arrive before the call to this function returns.
	// DequeueStoppingEvent returns S_OK if there is a stopping
	// event queued and it was successfully dequeued.
	// DequeueStoppingEvent returns S_FALSE if there are no stopping
	// events queued for this process.
	// DequeueStoppingEvent returns E_* for any failure that occurs while processing.
	HRESULT DequeueStoppingEvent(void);

	// Provide a way to indicate the HostingProcessLanguage so that the managed
	// debug engine can preload the right EE.
	HRESULT SetHostingProcessLanguage([in] REFGUID guidLang);
	HRESULT GetHostingProcessLanguage([out] GUID* pguidLang);

	// Provide a mechanism for the Package to explicitly disable ENC.
	// EncUnavailableReason is defined in enc.idl
	HRESULT DisableENC([in]EncUnavailableReason reason);
	HRESULT GetENCAvailableState([out]EncUnavailableReason* preason);
};

[
	object,
	uuid(C0537D44-8165-49d0-A626-D934F153D674),
	pointer_default(unique)
]
interface IDebugStoppingEventQueuedEvent2__depricated_C0537D44: IUnknown
{
	HRESULT GetEvent(
		[out] IDebugProcess2** ppProcess,
