}

enum __UPDATE_REFERENCE_REASON
{
    URR_PROJECT_OPEN,
    URR_BUILD,
    URR_START_DEBUG,
    URR_REFERENCEPATH_CHANGED,
    URR_REFERENCE_ADDED,
    URR_REFERENCE_REMOVED,
