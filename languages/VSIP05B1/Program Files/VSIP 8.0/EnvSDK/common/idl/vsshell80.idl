//------------------------------------------------------------------------------
// Preview Changes Tool Window
//------------------------------------------------------------------------------

// This is the check-state of an item.
enum __PREVIEWCHANGESITEMCHECKSTATE
{
    PCCS_None = 0,              // Item doesn't have a checkbox channel
    PCCS_Unchecked = 1,         // Item and all its descendants are unchecked.
    PCCS_PartiallyChecked = 2,   // Some descendants of this item are checked and some others are unchecked.
    PCCS_Checked = 3           // Item and all its descendants are checked.
};
typedef LONG PREVIEWCHANGESITEMCHECKSTATE;


// This is the display state of an item.
enum __PREVIEWCHANGESITEMDISPLAYSTATE
{
    PCDS_Normal,        // Checkbox can be edited by user.
    PCDS_Completed,     // Has been refactored already. Checkbox is not editable.
    PCDS_Error          // Need to fix error before refactoring.
};
typedef LONG PREVIEWCHANGESITEMDISPLAYSTATE;


// IVsPreviewChangesList interface. This is a list of items in the changes tree of the Preview Changes Tool Window.
[
    uuid(uuid_IVsPreviewChangesList),
    version(1.0),
    pointer_default(unique)
]
interface IVsPreviewChangesList : IUnknown
{
    //--------------------------------------------------------------------------
    // Methods "inherited" from IVsLiteTreeList
    //--------------------------------------------------------------------------

    HRESULT GetFlags([out] VSTREEFLAGS *pFlags);
    HRESULT GetItemCount([out] ULONG* pCount);
    HRESULT GetExpandedList([in] ULONG Index, [out] BOOL *pfCanRecurse, [out] IVsLiteTreeList **pptlNode);
    HRESULT LocateExpandedList([in] IVsLiteTreeList* ExpandedList, [out] ULONG *iIndex);
    HRESULT OnClose([out] VSTREECLOSEACTIONS *ptca);
    HRESULT GetText([in] ULONG Index, [in] VSTREETEXTOPTIONS tto, [out] const WCHAR **ppszText);
    HRESULT GetTipText([in] ULONG Index, [in] VSTREETOOLTIPTYPE eTipType, [out] const WCHAR **ppszText); 
    HRESULT GetExpandable([in] ULONG Index, [out] BOOL *pfExpandable);
    [local] HRESULT GetDisplayData([in] ULONG Index, [out] VSTREEDISPLAYDATA *pData);
    HRESULT UpdateCounter([out] ULONG *pCurUpdate,  [out] VSTREEITEMCHANGESMASK *pgrfChanges);
    HRESULT GetListChanges([in,out] ULONG *pcChanges, [in, size_is(*pcChanges)] VSTREELISTITEMCHANGE *prgListChanges);
    HRESULT ToggleState([in] ULONG Index, [out] VSTREESTATECHANGEREFRESH *ptscr);

    //--------------------------------------------------------------------------
    // Methods extending IVsLiteTreeList
    //--------------------------------------------------------------------------

    // Request source for list element to be hung off text view
    HRESULT OnRequestSource([in] ULONG Index, [in] IUnknown *pIUnknownTextView);
};

// IVsPreviewChangesEngine interface (implemented by refactoring engine)
[
    uuid(uuid_IVsPreviewChangesEngine),
    version(1.0),
    pointer_default(unique)
]
interface IVsPreviewChangesEngine : IUnknown
{
    // Get dialog title text
    HRESULT GetTitle([out] BSTR *pbstrTitle);
    // Get dialog description text 
    HRESULT GetDescription([out] BSTR *pbstrDescription);
    // Get dialog confirmation button text 
    HRESULT GetConfirmation([out] BSTR *pbstrConfirmation);
    // Get root changes list
    HRESULT GetRootChangesList([out] IVsPreviewChangesList **ppIVsPreviewChangesList);
    // Apply changes
    HRESULT ApplyChanges();
};


// uuid_IVsPreviewChangesService interface
[
    uuid(uuid_IVsPreviewChangesService),
    version(1.0),
    pointer_default(unique)
]
interface IVsPreviewChangesService : IUnknown
{
    // Preview Changes (calling back to given refactoring engine)
    HRESULT PreviewChanges([in] IVsPreviewChangesEngine *pIVsPreviewChangesEngine);
};
cpp_quote("#define SID_SVsPreviewChangesService IID_IVsPreviewChangesService")


// This is the state of the Preview Changes tool window.
enum __PREVIEWCHANGESPANESTATE
{
    PCPS_Ready,         // Changes list is up-to-date.
    PCPS_NeedsRefresh,  // Data has changed. Changes list in window is not current.
    PCPS_InProgress,    // Refactoring engine is busy doing work.
    PCPS_Failed,        // Changes list in window contains errors. 
    PCPS_Completed      // Refactoring is complete. 
};
typedef LONG PREVIEWCHANGESPANESTATE;


// These are some options when requesting changes lists from the refactoring engine.
enum __PREVIEWCHANGESLISTOPTIONS
{
    PCLO_IncludeSymbols     = 0x0001,    
    PCLO_IncludeStrings     = 0x0002,
    PCLO_IncludeComments    = 0x0004
};
typedef DWORD PREVIEWCHANGESLISTOPTIONS;


// Parameters used to change state in the Preview Changes tool window.
typedef struct __PREVIEWCHANGESPANESTATEINFO
{
    PREVIEWCHANGESPANESTATE state;
    BSTR                    bstrMessage;
} PREVIEWCHANGESPANESTATEINFO;


// IVsPreviewChangesPane interface. This is the Preview Changes Tool Window interface.
[
    uuid(uuid_IVsRefactoringEngine),
    version(1.0),
    pointer_default(unique)
]
interface IVsRefactoringEngine : IUnknown
{
    // Non-blocking call (returns immediately).  Implements refactoring in background thread.
    // If this call is blocking, then the PreviewChangesPane will block and user will not be
    // able to press the Stop button.
    HRESULT StartRefactoring ( );

    // Stops background refactoring thread and returns new state.
    HRESULT StopRefactoring([out] PREVIEWCHANGESPANESTATEINFO* pStateInfo);

    // Refreshes changes list in RefactoringEngine with new options. Based on contents of
    // list, new state is set. The PreviewChangesPane will redraw itself completely after
    // calling this method.
    HRESULT RefreshChangesList
    (
        [in] PREVIEWCHANGESLISTOPTIONS options,         // List options.
        [out] IVsPreviewChangesList** ppList,           // Top level list of changes.
        [out] PREVIEWCHANGESPANESTATEINFO* pStateInfo   // New state.
    );
};



