    HRESULT LogEntryGuidHr    ( [in] ACTIVITYLOG_ENTRYTYPE actType, [in] LPCOLESTR pszSource, [in] LPCOLESTR pszDescription, [in] GUID guid, [in] HRESULT hr                         );
