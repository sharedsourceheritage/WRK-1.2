{
    CBM_CALLSTO             = 0,
    CBM_CALLSTO_NEWWINDOW   = 1,
    CBM_CALLSFROM           = 2,
    CBM_CALLSFROM_NEWWINDOW = 3
};
typedef LONG CALLBROWSERMODE;

