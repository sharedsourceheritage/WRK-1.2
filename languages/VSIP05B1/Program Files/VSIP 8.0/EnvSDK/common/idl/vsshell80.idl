//----------------------------------------------------------------------------
//  interface IVsACAdapter
//----------------------------------------------------------------------------
// Implemented by the Environment. 
// This is an adapter interface used by IVsAutoCompletionUI to communicate with it's clients 
// all clients of the IVsAutoCompletionUI service must implement this interface

[
    uuid(uuid_IVsACAdapter),
    version(1.0),
    pointer_default(unique)
]

interface IVsACAdapter: IUnknown
{

    // What kind of mode are we in, autocompletion mode or no autocompletion mode
    HRESULT FAutoCompletionMode();

    // An event fired when autocompletion begins
    HRESULT OnStartAutocompletion();

    // Get the string being entered on which autocompletion will operate  
    HRESULT GetTargetText([out]BSTR* pbstrTargetText);

    // Get the offset of the caret within the target text (as returned by GetTargetText)
    HRESULT GetCursorPos([out]int* piCursorPos);

    // Return the location (in screen coordinates) of a portion of the text in the UI.  The
    // portion is specified by an offset within the target text and a count of characters.
    // This controls the positioning of the autocompletion list.
    HRESULT GetACRect([in]int cchOffset, [in]int cchLength, [out]RECT* pRect);

    // The user has picked an item from the autocompletion list.  Set the target text and 
    // the selected text or the cursor as specified.  The command prefix, if any, is never part of the text.  It must
    // be added by the UI, and the cursor position must be adjusted appropriately. 
    HRESULT UpdateTargetTextFromACPick([in]BSTR bstrPickText, [in]int iSelectionStart, [in]int iSelectionEnd);

    // Extract the substring autocompletion should operate on
    // get the offset from the beginning, the text and the length
    HRESULT ExtractACSubstring([in]const WCHAR* szText, [in]int iCursorPos, 
        [out]BSTR* pbstrSubstring, [out]int* piACOffset, [out]int* piACLength);

    // Format AC Text lets the user format the text that comes out of the autocompletion, 
    // right before it is put inside an edit control
    // for example, the user may want to check for spaces inside the text, and if those 
    // exist put quotes around it
    HRESULT FormatACText([in][out]WCHAR* szACText);
};

//----------------------------------------------------------------------------
//  interface IVsAutoCompletion
//----------------------------------------------------------------------------
// Implemented by the Environment. 
// This is a service that provides autocompletion on edit controls
// IVsAutoCompletion provides basic autocompletion given a HWND to a simple edit control
// one should refer to IVsAutoCompletionUI for advanced autocompletion where the user can
// handle the breaking up of their text and pass those portions to the autocompletion service

// types of autocompletion
typedef enum __tagACOPTION
{
    // Types of autocompletion styles, either pop up autocompletion or inline autocompletion
    // Note: when working with popup autocompletion, sources such as ACS_COMMANDS, ACS_SOLUTIONFILES,
    // ACS_PROJECTTEMPLATES and ACS_PROJECTTEMPLATES contain strings which may change when they get copied
    // into their target. For example ACS_PROJECTTEMPLATES may contain a path in c (a\b) format which get's copied
    // on to the target in a\b\c format. This behavior is dissabled for inline autocompletion. The text in the target,
    // when using inline autocompletion will appear just like the text contained in the autocompletion list. So for example
    // c (a\b) will appear as c (a\b) in the target when using inline autocompletion.
    ACO_INLINE = 0,
    ACO_POPUP = 1
}__ACOPTION;

// ACOPTIONS refers to the set options specified in the _ACOPTION enum
typedef int ACOPTIONS;

typedef enum __tagACLISTINDEX
{
    // AutocompletionList indexes
    // Requests for indices in the range ACLI_SYNCH_MIN...ACLI_SYNCH_MAX are
    // handled synchronously, on the calling thread.  Those in the range
    // ACLI_ASYNCH_MIN...ACLI_ASYNCH_MAX must be handled on the shell's main thread
    // using VSM_GETCOMMANDLINEACLIST.

    ACLI_INVALID = -2,
    ACLI_NONE = -1,
    ACLI_MIN = 0,
    ACLI_ASYNCH_MIN = 0,
    // ---------------
    ACLI_COMMANDS = ACLI_ASYNCH_MIN,
    ACLI_ALIASES,
    ACLI_SOLUTIONFILES,
    ACLI_PROJECTTEMPLATES,
    ACLI_FILETEMPLATES,
    // ---------------
    ACLI_ASYNCH_MAX = ACLI_FILETEMPLATES,
    ACLI_SYNCH_MIN = 16,
    // ---------------
    ACLI_URL = ACLI_SYNCH_MIN,
    ACLI_DISKFILES,
    ACLI_DIRECTORIES,
    ACLI_USERPROVIDED,
    // ---------------
    ACLI_SYNCH_MAX = ACLI_USERPROVIDED,
    ACLI_MAX = 32
} __ACLISTINDEX;

typedef enum __tagACSOURCE
{
    // Autocompletion sources specify what the service autocompletes on.
    // More than one different source of autocompletion can be set at once. For example, ACS_URL | ACS_DISKFILES will enable autocompletion on both
    // URLs and DISKFILES
    ACS_COMMANDS         = 1 << ACLI_COMMANDS,
    ACS_ALIASES          = 1 << ACLI_ALIASES,
    ACS_SOLUTIONFILES    = 1 << ACLI_SOLUTIONFILES,
    ACS_PROJECTTEMPLATES = 1 << ACLI_PROJECTTEMPLATES,
    ACS_FILETEMPLATES    = 1 << ACLI_FILETEMPLATES,

    ACS_URL              = 1 << ACLI_URL,
    ACS_DISKFILES        = 1 << ACLI_DISKFILES,
    ACS_DIRECTORIES      = 1 << ACLI_DIRECTORIES,
    ACS_USERPROVIDED     = 1 << ACLI_USERPROVIDED
}__ACSOURCE;

// ACSOURCES refers to the sources specified in the _ACSOURCE
typedef DWORD ACSOURCES;


typedef enum __tagACLISTOPTION
{
    // filter criteria for an AutoCompletion List
    // the filtering criteria works only when sources are set to either diskfiles and or directories
    ACLISTO_NONE            = 0,    // enumerate only on the absolute paths
    ACLISTO_CURRENTDIR      = 1,    // enumerate on absolute paths and the relative path if the correct relative path is set
    ACLISTO_MYCOMPUTER      = 2,    // enumerate MyComputer
    ACLISTO_DESKTOP         = 4,    // enumerate Desktop Folder
    ACLISTO_FAVORITES       = 8,    // enumerate Favorites Folder
    ACLISTO_FILESYSONLY     = 16,   // enumerate only the file system
    ACLISTO_FILESYSDIRS     = 32    // enumerate only the file system dirs, UNC shares, and UNC servers.

} __ACLISTOPTION;

// ACLISTOPTIONS refers to the set filtering criteria for the AutoCompletionList specified in the __ACLISTOPTION enum
typedef int ACLISTOPTIONS;

[
    uuid(uuid_IVsAutoCompletion),
    version(1.0),
    pointer_default(unique)
]

interface IVsAutoCompletion : IUnknown
{
    // Init takes in a handle to an edit control, based on the autocompletion sources and options set
    // the service autocompletes on the text inside the edit control
    // the user can specify a set of delimeter chars in which case autocompletion will work with the text
    // located in between the delimeters... for example if the set delimeters are L",;" and the text inside
    // the edit control is one;two,three;four ... if the user tries to modify "one", then autocompletion will position
    // itself and autocomplete on the "one" token ... the same happens if the user tries to modify "two" and so on
    HRESULT Init([in] HWND hwndEdit, [in]const WCHAR* pszDelim);

    // SetStartDir sets the relative path for the autocompletion. For example if the relative path is set to a valid dir, the
    // sources are either diskfiles and or directories and ACLISTOPTIONS  == ACLISTO_CURRENTDIR, then autocompletion will show 
    // all diskfiles and or directories in the relative path
    HRESULT SetStartDir([in, ref]const WCHAR* pszStartDir);

    // The autocompletion service supports autocompletion on more than one source, example: ACS_COMMANDS | ACS_DISKFILES 
    // will result in autocompletion on both commands and diskfiles 
    HRESULT SetSources([in]ACSOURCES grfSources);

    // In some cases the user may want to provide their own source of autocompletion to the combination of already
    // provided sourced to do this the user needs to provide the autocompletion service an IEnumString, if fCopy is false 
    // service will keep a reference to the IEnumString, if fCopy is true the service will make a deep copy of it 
    // NOTE: the user provided source will only be activated if the ACSOURCE: ACS_USERPROVIDED is set
    // FURTHER NOTE: if a deep copy isn't made, the reference to the IEnumString will be accessed on the background thread
    HRESULT SetUserProvidedEnum([in]IEnumString* pesUserProvidedEnum, [in]BOOL fCopy);

    // By setting the filtering criteria for the autocompletion list the user can control if the autocompletionList should 
    // work with an absolute or relative path. 
    HRESULT SetACListOptions([in]ACLISTOPTIONS grfACListOptions);

    // Sets autocompletion options such as inline and dropdown 
    HRESULT SetACOptions([in]ACOPTIONS grfOptions);

    HRESULT GetStartDir([out, retval]BSTR* pbstrStartDir); 
    HRESULT GetSources([out, retval]ACSOURCES* pgrfSources);
    HRESULT GetACOptions([out, retval]ACOPTIONS* pgrfOptions);
    HRESULT GetACListOptions([out, retval]ACLISTOPTIONS* pgrfACListOptions);
    HRESULT GetUserProvidedEnum([out, retval]IEnumString** pesUserProvidedEnum);
};

cpp_quote("#define SID_SVsAutoCompletion IID_IVsAutoCompletion")

//----------------------------------------------------------------------------
//  interface IVsAutoCompletionUI
//----------------------------------------------------------------------------
// Implemented by the Environment. 
// This is a service that provides advanced autocompletion.
// The users are given the option to break up the text in their edit control and pass portions 
// of it to the IVsAutoCompletionUI to get inline or popup autocompletion. 
// Note: To do this, the users of IVsAutoCompletionUI must implement the IVsACAdapter interface.
[
    uuid(uuid_IVsAutoCompletionUI),
    version(1.0),
    pointer_default(unique)
]
interface IVsAutoCompletionUI : IUnknown
{
    // Init takes in a pointer to the IACAdapter interface and autocompletion options. 
    HRESULT InitUI([in] IVsACAdapter* iacAdapter);

    HRESULT OnTargetTextChanged([in]BOOL fForceIfEmpty);
    HRESULT OnKey([in]UINT uMsg, [in]WPARAM wParam, [in]LPARAM lParam);
    HRESULT OnChar([in]WPARAM wParam, [in]LPARAM lParam);
    HRESULT OnKillFocus();
    HRESULT OnSetFocus();

    // autocomplete on the current selection
    // pick the currently selected (or first) item from the autocomplete list
    HRESULT Complete();

    // cancel autocompletion on the current selection
    // hide the autocompletion list
    HRESULT Cancel();

    // forces the autocompletion to requery the source
    HRESULT ForceRequery();

    // checks if the current pop-up autocompletion list is displayed
    HRESULT IsACDroppedDown();

    // gets the item selected in the pop-up autocompletion list
    HRESULT GetACListSelection([out]BSTR* pbstrSel);

    // grabs the current autocompletion list window
    HRESULT GetACWindow ([out]HWND* hwndACWindow);
}

