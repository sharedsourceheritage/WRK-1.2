{
    // Return startup options
    HRESULT QueryDebugTargets([in] VSDBGLAUNCHFLAGS grfLaunch,
                              [in] ULONG cTargets,
                              [in, out, size_is(cTargets)] VsDebugTargetInfo2 rgDebugTargetInfo[],
                              [out, optional] ULONG *pcActual);
}


