    HRESULT LogEntryHrPath    ( [in] ACTIVITYLOG_ENTRYTYPE actType, [in] LPCOLESTR pszSource, [in] LPCOLESTR pszDescription,                 [in] HRESULT hr, [in] LPCOLESTR pszPath );
