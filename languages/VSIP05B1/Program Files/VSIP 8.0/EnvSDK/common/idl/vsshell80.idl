    //HRESULT GetSupportedCategoryFields([in] LIB_CATEGORY Category, [out, retval] DWORD *pCatField);
    HRESULT GetSupportedCategoryFields2([in] LIB_CATEGORY2 Category, [out, retval] DWORD *pgrfCatField);

