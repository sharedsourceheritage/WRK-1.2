// Package Command Bar Definition
//

#include "stdidcmd.h"
#include "vsshlids.h"
#include "msobtnid.h"
#include "virtkeys.h"
#include "PkgCmdID.h"
#include "Resource.h"

#define _CTC_GUIDS_
#include "Guids.h"

// shorthand macros for a more compact and manageable table

#define OI_NOID         guidOfficeIcon:msotcidNoIcon
#define DIS_DEF         DEFAULTDISABLED | DEFAULTINVISIBLE | DYNAMICVISIBILITY
#define VIS_DEF         COMMANDWELLONLY


CMDS_SECTION guidDynamicMenuPkg

    MENUS_BEGIN
        // NewMenu                              Relative to Group                     Priority    Type        Name          Text
        guidDynamicMenuMenuGrp:IDM_DYN_CASCADE, guidDynamicMenuMenuGrp:MyMenuGroup,   0x0000,     ,           "MenuTest",   "Menu Test";
    MENUS_END

    NEWGROUPS_BEGIN
    // NewGroup                                 Parent Group                            Priority
    guidDynamicMenuMenuGrp:MyMenuGroup,         guidSHLMainMenu:IDM_VS_MENU_TOOLS,      0x0010;
    guidDynamicMenuMenuGrp:MyCascadeGroup,      guidDynamicMenuMenuGrp:IDM_DYN_CASCADE, 0x0010;
    guidDynamicMenuMenuGrp:MyCascadeDynGroup,   guidDynamicMenuMenuGrp:IDM_DYN_CASCADE, 0x0010;
    NEWGROUPS_END

    BUTTONS_BEGIN
        // Command                                  Parent Group                                Priority    Image                           Type    Visibility                      Text        
        guidDynamicMenuCmdSet:cmdidAddMenu,         guidDynamicMenuMenuGrp:MyCascadeGroup,      0x0100,     OI_NOID,                        BUTTON, TEXTCHANGES,                    "Add Menu";
        guidDynamicMenuCmdSet:cmdidRemoveMenu,      guidDynamicMenuMenuGrp:MyCascadeGroup,      0x0100,     OI_NOID,                        BUTTON, DEFAULTDISABLED | TEXTCHANGES,  "Remove Menu";
        
        guidDynamicMenuCmdSet:cmdidDynamicFirst,    guidDynamicMenuMenuGrp:MyCascadeDynGroup,   0x0100,     OI_NOID,                        BUTTON,  DYNAMICITEMSTART | TEXTCHANGES | DYNAMICVISIBILITY | DEFAULTINVISIBLE | DEFAULTDISABLED ,   " ";
        
        // Those commands are not defined as shared command, so they use our package CLSID
        // as the command set GUID. Also, by specifying blank for the FLAGS, this command is
        // default visible and enabled. Other valid values for FLAGS are the following:
        //    DEFAULTDISABLED, DEFAULTINVISIBLE, DYNAMICVISIBILITY, TEXTCHANGES
        // These values for FLAGS can be or'ed together, e.g. "DEFAULTINVISIBLE | DYNAMICVISIBILITY"
        // If you do not want an image next to your command, set the image to "guidOfficeIcon:msotcidNoIcon"

    BUTTONS_END

    BITMAPS_BEGIN
        // Bitmap                          Bitmap Index, Bitmap Index, ...
    guidDynamicMenuCmdSet:IDB_MENU_IMAGES,    bmpPic1, bmpPic2, bmpPicSmile, bmpPicX, bmpPicArrows;
    BITMAPS_END

CMDS_END

CMDUSED_SECTION
CMDUSED_END

CMDPLACEMENT_SECTION
    // Command                             Group                                Priority
CMDPLACEMENT_END

VISIBILITY_SECTION
    // Command                          GUID when visible
VISIBILITY_END

//////////////////////////////////////////////////////////////////////////////
// KEYBINDINGS_SECTION
// 
// This sections defines the keystroke mappings for the commands.
//
// The Keystate field is done using the following:
//    A = Alt, S = Shift, C = Control, W = Windows Key
//
// Example of the Keystate assignment, if you want a two key combination
// of Ctrl-X, Ctrl-Shift-C then the syntax would be :
//
//	'x':C:'c':CS
//
//////////////////////////////////////////////////////////////////////////////

KEYBINDINGS_SECTION
	// Command                		when available  		emulation   			keystate
KEYBINDINGS_END
