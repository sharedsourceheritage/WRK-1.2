	interface _OptionsPreferences : IDispatch
	{
		[propget, id(1), helpstring("property Setting")] HRESULT Setting([out, retval] BSTR *pVal);
		[propput, id(1), helpstring("property Setting")] HRESULT Setting([in] BSTR newVal);
	};

	[
		uuid(40770774-3E9E-11D2-9761-00A0C90A6BFE),
		helpstring("OptionsPreferences Class")
	]
