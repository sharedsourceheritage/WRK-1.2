HKLM
{
    %REGROOTBEGIN%
    NoRemove Packages
    {
        %CLSID_Package% = s 'OptPkg Package'
        {
            val InprocServer32 = s '%MODULE%'

            val CompanyName = s 'Microsoft'
            val ProductName = s 'Tools Option Package Sample'
            val ProductVersion  = s '7.1'
            val MinEdition  = s 'professional'
            val ID  = d '%IDS_PACKAGE_LOAD_KEY%'
 
            SatelliteDll
            {
                val DllName = s '%RESOURCE_DLL%'
                val Path = s '%RESOURCE_PATH%'
            }
        }
    }
    NoRemove AutomationProperties
    {
        'OptionsSample'
        {
            'General'
            {
                val Name = s 'OptionsSample.General'
                val Package = s '%CLSID_Package%'
            }
        }
    }
    NoRemove Menus
    {
        val %CLSID_Package% = s ', 1000, 1'
    }
    NoRemove ToolsOptionsPages
    {
        OptionsSample = s '#%IDS_PACKAGE%'
        {
            val Package = s '%CLSID_Package%'
            val Sort = d '1000'
            General = s '#%IDS_GENERAL%'
            {
                val Package = s '%CLSID_Package%'
                val Page = s '%guidOptionsPage%'
            }
        }
    }
    NoRemove InstalledProducts
    {
        'OptionsPackageSample' = s #%IDS_OFFICIALNAME%
        {
            val Package = s '%CLSID_Package%'
            val ProductDetails = s #%IDS_PRODUCTDETAILS%
            val LogoID = s '#0'
            val PID = s '7.1'
            val UseInterface = d '0'
        }
    }

    %REGROOTEND%
}
