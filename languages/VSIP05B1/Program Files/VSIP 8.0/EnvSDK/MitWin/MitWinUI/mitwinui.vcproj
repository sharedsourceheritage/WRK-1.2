<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="MitWinUI"
	SccProjectName=""
	SccLocalPath="">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\..\MitWin\Release\1033"
			IntermediateDirectory=".\Release"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				RuntimeLibrary="0"
				BufferSecurityCheck="TRUE"
				PrecompiledHeaderFile=".\Release/MitWinUI.pch"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				IgnoreImportLibrary="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="odbc32.lib odbccp32.lib"
				OutputFile=".\..\MitWin\Release\1033/MitWinUI.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				ProgramDatabaseFile=".\..\MitWin\Release\1033/MitWinUI.pdb"
				ResourceOnlyDLL="TRUE"
				BaseAddress="@..\..\dllbaseEnvSDK.txt,mitwinui"
				ImportLibrary=""/>
			<Tool
				Name="VCMIDLTool"
				TypeLibraryName=".\..\MitWin\Release\1033/MitWinUI.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				AdditionalOptions="-r "
				PreprocessorDefinitions="UNICODE,_UNICODE,_X86_=1,i386=1,WIN32,WINNT=1,NDEBUG,_NEW_SDK=1"
				Culture="1033"
				AdditionalIncludeDirectories="..\..\common\inc;.\Release;.."/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\..\MitWin\Debug\1033"
			IntermediateDirectory=".\Debug"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				RuntimeLibrary="1"
				BufferSecurityCheck="TRUE"
				PrecompiledHeaderFile=".\Debug/MitWinUI.pch"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				IgnoreImportLibrary="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="odbc32.lib odbccp32.lib"
				OutputFile=".\..\MitWin\Debug\1033/MitWinUI.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\..\MitWin\Debug\1033/MitWinUI.pdb"
				ResourceOnlyDLL="TRUE"
				BaseAddress="@..\..\dllbaseEnvSDK.txt,mitwinui"
				ImportLibrary=""/>
			<Tool
				Name="VCMIDLTool"
				TypeLibraryName=".\..\MitWin\Debug\1033/MitWinUI.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				AdditionalOptions="-r "
				PreprocessorDefinitions="UNICODE,_UNICODE,_X86_=1,i386=1,WIN32,WINNT=1,_DEBUG,DEBUG,_NEW_SDK=1"
				Culture="1033"
				AdditionalIncludeDirectories="..\..\common\inc;.\Debug;.."/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath=".\PkgCmdID.h">
			</File>
			<File
				RelativePath=".\Resource.h">
			</File>
		</Filter>
		<Filter
			Name="Resource Files"
			Filter="rc;ico;cur;bmp;dlg;rc2;rct;bin;rgs;gif;jpg;jpeg;jpe">
			<File
				RelativePath="..\res\CmdBar.bmp">
			</File>
			<File
				RelativePath=".\MitWinUI.rc">
			</File>
			<File
				RelativePath=".\PkgCmd.ctc">
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCCustomBuildTool"
						CommandLine="..\..\tools\bin\x86\ctc -nologo .\pkgcmd.ctc Release\pkgcmd.cto -Ccl -I..\..\common\inc -I..\..\common\inc\office10&#x0D;&#x0A;"
						Outputs="Release\pkgcmd.cto"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCCustomBuildTool"
						CommandLine="..\..\tools\bin\x86\ctc -nologo .\pkgcmd.ctc Debug\pkgcmd.cto -Ccl -I..\..\common\inc -I..\..\common\inc\office10&#x0D;&#x0A;"
						Outputs="Debug\pkgcmd.cto"/>
				</FileConfiguration>
			</File>
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
