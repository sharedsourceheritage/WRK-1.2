// FileEx.idl : FileEx Package interfaces
//

// This file will be processed by the MIDL tool to
// produce the type library (FileEx.tlb) and marshalling code.

import "oaidl.idl";
import "ocidl.idl";
import "vsshell.idl";

interface IFileSystemToolWindow;
interface IFileSystemPane;
interface IFileSystemFolderPane;
interface IFileSystemFilePane;
interface IFileSystemSelectionContainer;
interface IFileSystemSelection;

interface IMagicDisplay;
interface ICommandExecuter;

///////////////////////////////////////////////////////////////////////////////
// IFileSystemToolWindow
[
    uuid(ED7B8ACA-05C1-11d3-9AA9-00C04F79EFC3),
    version(1.0),
    helpstring("IFileSystemToolWindow Interface")
]
interface IFileSystemToolWindow : IUnknown
{
};

cpp_quote("#define SID_SFileSystemToolWindow IID_IFileSystemToolWindow")


///////////////////////////////////////////////////////////////////////////////
// IFileSystemPane
[
    uuid(ED7B8AC5-05C1-11d3-9AA9-00C04F79EFC3),
    version(1.0),
    helpstring("IFileSystemPane Interface")
]
interface IFileSystemPane : IUnknown
{
    HRESULT Initialize(
                    [in] IServiceProvider* pSP,
                    [in] HWND              hwndParent,
                    [in] HFONT             hFont);
    HRESULT GetPaneWindow(
                    [out] HWND* phwndPane);
};

