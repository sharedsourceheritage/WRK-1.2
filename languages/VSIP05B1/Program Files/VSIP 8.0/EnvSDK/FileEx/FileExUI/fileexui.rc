IDD_COMMANDS DIALOG DISCARDABLE  0, 0, 249, 184
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Define Commands"
FONT 8, "Tahoma"
BEGIN
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,26,8,219,1
    LTEXT           "Commands &List ",IDC_STATIC,4,4,50,8
    LISTBOX         IDC_CMD_COMMANDLIST,4,16,212,58,LBS_NOINTEGRALHEIGHT | 
                    LBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "U",IDC_CMD_CMDUP,220,16,18,16,BS_ICON
    PUSHBUTTON      "D",IDC_CMD_CMDDOWN,220,34,18,16,BS_ICON
    PUSHBUTTON      "X",IDC_CMD_CMDDEL,220,58,18,16,BS_ICON
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,26,82,219,1
    LTEXT           "Command &Details ",IDC_STATIC,4,78,58,8
    LTEXT           "&Name:",IDC_STATIC,8,91,22,8
    EDITTEXT        IDC_CMD_NAME,60,88,156,14,ES_AUTOHSCROLL
    LTEXT           "&Command:",IDC_STATIC,8,108,35,8
    EDITTEXT        IDC_CMD_COMMAND,60,105,156,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_CMD_CMDBROWSE,220,105,17,14
    LTEXT           "&Arguments:",IDC_STATIC,8,125,38,8
    EDITTEXT        IDC_CMD_ARGUMENTS,60,122,156,14,ES_AUTOHSCROLL
    PUSHBUTTON      ">",IDC_CMD_ARGMACRO,220,122,17,14,BS_ICON
    CONTROL         "Use &Output Window",IDC_CMD_USEOUTPUT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,8,144,80,10
    CONTROL         "Cl&ear Output Window",IDC_CMD_CLEAROUTPUT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,126,144,85,10
    PUSHBUTTON      "&Update",IDC_CMD_UPDATE,4,166,50,14
    PUSHBUTTON      "A&dd",IDC_CMD_ADD,57,166,50,14
    DEFPUSHBUTTON   "OK",IDOK,195,166,50,14
END

IDD_MAGIC DIALOGEX 0, 0, 174, 87
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Magic"
FONT 8, "Tahoma", 0, 0, 0x1
