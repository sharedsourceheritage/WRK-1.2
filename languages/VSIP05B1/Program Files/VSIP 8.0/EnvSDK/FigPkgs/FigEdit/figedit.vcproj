<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="FigEdit"
	ProjectGUID="{5464BE24-29B8-4F45-8599-648A9994635C}"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="..\Debug"
			IntermediateDirectory="Debug"
			ConfigurationType="2"
			CharacterSet="1"
			>
			<Tool
				Name="VCPreBuildEventTool"
			/>
			<Tool
				Name="VCCustomBuildTool"
			/>
			<Tool
				Name="VCXMLDataGeneratorTool"
				ExecutionBucket="5"
			/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"
				ExecutionBucket="6"
			/>
			<Tool
				Name="VCMIDLTool"
				ExecutionBucket="8"
				AdditionalOptions="/server none /no_format_opt&#x0D;&#x0A;-D_NEW_SDK=1 -D_WINDOWS -D_USRDLL -D_WIN32_DCOM -D_ATL_NO_UUIDOF &#x0D;&#x0A;-D_ATL_STATIC_REGISTRY -Di386 -D_X86_ -D_UNICODE -DUNICODE -D_WCHAR_T_DEFINED&#x0D;&#x0A;-D__MIDL__=1 &#x0D;&#x0A;-ms_ext -c_ext /win32 -no_warn /client none"
				AdditionalIncludeDirectories="..\..\common\idl;..\Parse;..\..\common\tlb;..\..\common\inc"
				WarningLevel="0"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				GenerateStublessProxies="TRUE"
				TypeLibraryName="$(IntDir)\$(InputName).tlb"
				HeaderFileName="$(IntDir)\$(InputName).h"
				DLLDataFileName="$(IntDir)\$(InputName)_d.c"
				InterfaceIdentifierFileName="$(IntDir)\$(InputName)_i.c"
				ProxyFileName="$(IntDir)\$(InputName)_p.c"
				EnableErrorChecks="2"
				StructMemberAlignment="4"
			/>
			<Tool
				Name="VCCLCompilerTool"
				ExecutionBucket="9"
				AdditionalOptions="-EHsc&#x0D;&#x0A;"
				Optimization="0"
				AdditionalIncludeDirectories="..\..\common\VsEnvSdkUtil;..\..\common\inc;$(IntDir);..\parse\$(IntDir)"
				PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS;_USRDLL;DEBUG;TLC=2;TLD=2;TLM=2;TLF=3;TLI=4;_UNICODE;UNICODE;_X86_=1;i386=1;WINNT=1;_DLL=1;_MT=1;_NEW_SDK=1;_WIN32_DCOM;_ATL_NO_UUIDOF;_ATL_STATIC_REGISTRY"
				IgnoreStandardIncludePath="FALSE"
				StringPooling="TRUE"
				MinimalRebuild="TRUE"
				BasicRuntimeChecks="0"
				RuntimeLibrary="3"
				BufferSecurityCheck="TRUE"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="3"
				ProgramDataBaseFileName="$(IntDir)/$(TargetName)_vc70.pdb"
				BrowseInformation="1"
				WarningLevel="3"
				WarnAsError="TRUE"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"
				CallingConvention="2"
				DisableSpecificWarnings="4996"
				ForcedIncludeFiles="..\..\common\inc\warning.h"
			/>
			<Tool
				Name="VCManagedResourceCompilerTool"
				ExecutionBucket="10"
			/>
			<Tool
				Name="VCResourceCompilerTool"
				ExecutionBucket="11"
				AdditionalIncludeDirectories="..\..\common\inc;$(IntDir)"
			/>
			<Tool
				Name="VCPreLinkEventTool"
				ExecutionBucket="12"
			/>
			<Tool
				Name="VCLinkerTool"
				ExecutionBucket="14"
				RegisterOutput="TRUE"
				AdditionalOptions="/machine:I386"
				AdditionalDependencies="VsEnvSdkUtilD.lib vsguids.lib atlsd.lib vsassert.lib winspool.lib comdlg32.lib odbc32.lib odbccp32.lib comctl32.lib kernel32.lib user32.lib gdi32.lib advapi32.lib oleaut32.lib ole32.lib uuid.lib shell32.lib shlwapi.lib msvcrtd.lib msvcprtd.lib oldnames.lib"
				LinkIncremental="2"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="..\..\common\lib\x86\debug"
				IgnoreAllDefaultLibraries="TRUE"
				ModuleDefinitionFile="&quot;.\FigEdit.def&quot;"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="$(OutDir)/FigEdit.pdb"
				SubSystem="2"
				EntryPointSymbol="_DllMainCRTStartup@12"
				ImportLibrary="$(OutDir)/FigEdit.lib"
			/>
			<Tool
				Name="VCXDCMakeTool"
			/>
			<Tool
				Name="VCALinkTool"
				ExecutionBucket="15"
			/>
			<Tool
				Name="VCManifestTool"
				ExecutionBucket="16"
			/>
			<Tool
				Name="VCBscMakeTool"
				ExecutionBucket="17"
			/>
			<Tool
				Name="VCAppVerifierTool"
			/>
			<Tool
				Name="VCWebDeploymentTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
			/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
