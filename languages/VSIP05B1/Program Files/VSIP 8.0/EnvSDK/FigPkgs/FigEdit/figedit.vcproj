			<Tool
				Name="VCCLCompilerTool"
				ExecutionBucket="9"
				AdditionalOptions="-EHsc&#x0D;&#x0A;"
				Optimization="2"
				InlineFunctionExpansion="1"
				OmitFramePointers="TRUE"
				AdditionalIncludeDirectories="..\..\common\VsEnvSdkUtil;..\..\common\inc;$(IntDir);..\parse\$(IntDir)"
				PreprocessorDefinitions="WIN32;NDEBUG;_WINDOWS;_USRDLL;TLC=2;TLD=2;TLM=2;TLF=3;TLI=4;UNICODE;_UNICODE;_X86_=1;i386=1;WINNT=1;_DLL=1;_MT=1;_NEW_SDK=1;_WIN32_DCOM;_ATL_NO_UUIDOF;_ATL_STATIC_REGISTRY"
				IgnoreStandardIncludePath="FALSE"
				StringPooling="TRUE"
				RuntimeLibrary="2"
				BufferSecurityCheck="TRUE"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="3"
				ProgramDataBaseFileName="$(IntDir)/$(TargetName)_vc70.pdb"
				BrowseInformation="1"
				WarningLevel="3"
				WarnAsError="TRUE"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"
				CallingConvention="2"
				DisableSpecificWarnings="4996"
				ForcedIncludeFiles="..\..\common\inc\warning.h"
			/>
			<Tool
				Name="VCManagedResourceCompilerTool"
				ExecutionBucket="10"
			/>
			<Tool
				Name="VCResourceCompilerTool"
				ExecutionBucket="11"
				AdditionalIncludeDirectories="..\..\common\inc;$(IntDir)"
			/>
			<Tool
				Name="VCPreLinkEventTool"
				ExecutionBucket="12"
			/>
			<Tool
				Name="VCLinkerTool"
				ExecutionBucket="14"
				RegisterOutput="TRUE"
				AdditionalOptions="/machine:I386"
				AdditionalDependencies="VsEnvSdkUtil.lib vsguids.lib atls.lib kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib comctl32.lib advapi32.lib shlwapi.lib msvcrt.lib msvcprt.lib oldnames.lib"
				OutputFile="$(OutDir)/FigEdit.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="..\..\common\lib\x86\retail"
				IgnoreAllDefaultLibraries="TRUE"
				ModuleDefinitionFile="&quot;.\FigEdit.def&quot;"
				GenerateDebugInformation="FALSE"
				SubSystem="2"
				OptimizeReferences="2"
				EnableCOMDATFolding="2"
				EntryPointSymbol="_DllMainCRTStartup@12"
				SetChecksum="TRUE"
				BaseAddress="@..\..\dllbaseEnvSDK.txt,figedit"
				ImportLibrary="$(OutDir)/FigEdit.lib"
			/>
			<Tool
				Name="VCXDCMakeTool"
			/>
			<Tool
				Name="VCALinkTool"
				ExecutionBucket="15"
			/>
			<Tool
				Name="VCManifestTool"
				ExecutionBucket="16"
			/>
			<Tool
				Name="VCBscMakeTool"
				ExecutionBucket="17"
			/>
			<Tool
				Name="VCAppVerifierTool"
			/>
			<Tool
				Name="VCWebDeploymentTool"
			/>
