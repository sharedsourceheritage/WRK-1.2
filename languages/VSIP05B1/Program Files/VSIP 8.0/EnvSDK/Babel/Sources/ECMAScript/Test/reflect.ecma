looplab: for (var i = 1; i < 10; i++){
  print(i);
  switch (i){
    case 1:
      print("one")
      continue looplab
    case 2:
      print("two")
      break
    default:
      print("default")
      break looplab
    case 3:
      print("three")
    case 4:
      print("four")
  }
}  
