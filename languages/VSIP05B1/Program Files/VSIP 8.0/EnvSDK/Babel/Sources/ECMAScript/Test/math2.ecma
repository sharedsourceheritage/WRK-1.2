var inf = Number.POSITIVE_INFINITY;
var nan = Number.NaN;
var pi  = Math.PI;
var e   = Math.E;
var ie  = 1/e;

var d11 = 1.000001;
var d09 = 0.999999;

var operands = [ "nan","+inf", "-inf", "+1",  "-1",  "+0","-0" ];
var roundOps = [ "nan","+inf", "-inf", "+3.5","-3.5",
                       "+d11", "-d11", "+d09","-d09","+0","-0" ];
var sinOps   = [ "nan","+inf", "-inf", "+pi", "-pi",  
                       "+pi/2","-pi/2","+0",  "-0" ];
var asinOps  = [ "nan","+inf", "-inf", "+d11","-d11",
                       "+1",   "-1",   "+0",  "-0" ];
var powLOps  = [ "nan","+inf", "-inf", "+4",  "-4",
                       "+1",   "-1",   "+0","-0" ];
var powROps  = [ "nan","+inf", "-inf", "+3",  "-3",
                       "+2",   "-2",   "+1.5","-1.5","+0","-0" ];

function BinaryTest(op, lOps, rOps, results)
{
	for (var l = 0; l < lOps.length; l++)
		for (var r = 0; r < rOps.length; r++) {
			var str = op + "(" + lOps[l] + "," + rOps[r] + ")";
			with (Math)
				var a = eval(str);
			var res = results[l][r];
			if (res == "small")
				print(str, " -> 0",
					!isNaN(a) && Math.abs(a) < 1e-15
						? ": true" : ": false: " + a);
			else if (res == "big")
				print(str, " -> Inf",
					!isNaN(a) && Math.abs(a) > 1e+15
						? ": true" : ": false: " + a);
			else {
				var b = eval(res);
				print(str, " == ", res,
					isNaN(a) && isNaN(b) || a == b && 1/a == 1/b
						? ": true" : ": false: " + a);
			}
		}
}

function UnaryTest(op, ops, results)
{
	for (var i = 0; i < ops.length; i++) {
		var str = op + "(" + ops[i] + ")";
		with (Math)
			var a = eval(str);
		var res = results[i];
		if (res == "small")
			print(str, " -> 0",
				!isNaN(a) && Math.abs(a) < 1e-15
					? ": true" : ": false: " + a);
		else if (res == "big")
			print(str, " -> Inf",
				!isNaN(a) && Math.abs(a) > 1e+15
					? ": true" : ": false: " + a);
		else {
			var b = eval(res);
			print(str, " == ", res,
				isNaN(a) && isNaN(b) || a == b && 1/a == 1/b
					? ": true" : ": false: " + a);
		}
	}
}

print("E: ",       Math.E       == +2.7182818284590450);
print("LOG2E: ",   Math.LOG2E   == +1.4426950408889634);
print("LOG10E: ",  Math.LOG10E  == +0.4342944819032518);
print("LN2: ",     Math.LN2     == +0.6931471805599453);
print("LN10: ",    Math.LN10    == +2.3025850929940460);
print("PI: ",      Math.PI      == +3.1415926535897930);
print("SQRT2: ",   Math.SQRT2   == +1.4142135623730951);
print("SQRT1_2: ", Math.SQRT1_2 == +0.7071067811865476);

var results = [ "nan","+inf","+inf","+1","+1","+0","+0" ];
UnaryTest("abs", operands, results);

results = [ "nan","+inf","-inf","+4","-3","+2","-1","+1","-0","+0","-0" ];
UnaryTest("ceil", roundOps, results);

results = [ "nan","+inf","-inf","+3","-4","+1","-2","+0","-1","+0","-0" ];
UnaryTest("floor", roundOps, results);

results = [ "nan","+inf","-inf","+4","-3","+1","-1","+1","-1","+0","-0" ];
UnaryTest("round", roundOps, results);

results = [ "nan","+inf","nan","+1","nan","+0","-0" ];
UnaryTest("sqrt", operands, results);

results = [ "nan","+inf","+0","+e","+ie","+1","+1" ];
UnaryTest("exp", operands, results);

results = [ "nan","+inf","nan","+0","nan","-inf","-inf" ];
UnaryTest("log", operands, results);

results = [ "nan","nan","nan","small","small","+1","-1","+0","-0" ];
UnaryTest("sin", sinOps, results);

results = [ "nan","nan","nan","-1","-1","small","small","+1","+1" ];
UnaryTest("cos", sinOps, results);

results = [ "nan","nan","nan","small","small","big","big","+0","-0" ];
UnaryTest("tan", sinOps, results);

results = [ "nan","nan","nan","nan","nan","+pi/2","-pi/2","+0","-0" ];
UnaryTest("asin", asinOps, results);

results = [ "nan","nan","nan","nan","nan","+0","+pi","+pi/2","+pi/2" ];
UnaryTest("acos", asinOps, results);

results = [ "nan","+pi/2","-pi/2","+pi/4","-pi/4","+0","-0" ];
UnaryTest("atan", operands, results);

results = [
	[ "nan","nan","nan","nan",  "nan",    "nan",   "nan"  ],
	[ "nan","nan","nan","+pi/2","+pi/2",  "+pi/2","+pi/2" ],
	[ "nan","nan","nan","-pi/2","-pi/2",  "-pi/2","-pi/2" ],
	[ "nan","+0", "+pi","+pi/4","+3*pi/4","+pi/2","+pi/2" ],
	[ "nan","-0", "-pi","-pi/4","-3*pi/4","-pi/2","-pi/2" ],
	[ "nan","+0", "+pi","+0",   "+pi",    "+0",   "+pi"   ],
	[ "nan","-0", "-pi","-0",   "-pi",    "-0",   "-pi"   ]];
BinaryTest("atan2", operands, operands, results);

results = [
	[ "nan","nan", "nan", "nan", "nan", "nan", "nan"  ],
	[ "nan","+inf","+inf","+inf","+inf","+inf","+inf" ],
	[ "nan","+inf","-inf","+1",  "-1",  "+0",  "-0"   ],
	[ "nan","+inf","+1",  "+1",  "+1",  "+1",  "+1"   ],
	[ "nan","+inf","-1",  "+1",  "-1",  "+0",  "-0"   ],
	[ "nan","+inf","+0",  "+1",  "+0",  "+0",  "+0"   ],
	[ "nan","+inf","-0",  "+1",  "-0",  "+0",  "-0"   ]];
BinaryTest("max", operands, operands, results);

results = [
	[ "nan","nan", "nan", "nan", "nan", "nan", "nan"  ],
	[ "nan","+inf","-inf","+1",  "-1",  "+0",  "-0"   ],
	[ "nan","-inf","-inf","-inf","-inf","-inf","-inf" ],
	[ "nan","+1",  "-inf","+1",  "-1",  "+0",  "-0"   ],
	[ "nan","-1",  "-inf","-1",  "-1",  "-1",  "-1"   ],
	[ "nan","+0",  "-inf","+0",  "-1",  "+0",  "-0"   ],
	[ "nan","-0",  "-inf","-0",  "-1",  "-0",  "-0"   ]];
BinaryTest("min", operands, operands, results);

results = [
	[ "nan","nan", "nan", "nan", "nan",  "nan", "nan",  "nan", "nan", "+1","+1" ],
	[ "nan","+inf","+0",  "+inf","+0",   "+inf","+0",   "+inf","+0",  "+1","+1" ],
	[ "nan","+inf","+0",  "-inf","-0",   "+inf","+0",   "+inf","+0",  "+1","+1" ],
	[ "nan","+inf","+0",  "+64", "+1/64","+16", "+1/16","8",   "+1/8","+1","+1" ],
	[ "nan","+inf","+0",  "-64", "-1/64","+16", "+1/16","nan", "nan", "+1","+1" ],
	[ "nan","nan", "nan", "+1",  "+1",   "+1",  "+1",   "+1",  "+1",  "+1","+1" ],
	[ "nan","nan", "nan", "-1",  "-1",   "+1",  "+1",   "nan", "nan", "+1","+1" ],
	[ "nan","+0",  "+inf","+0",  "+inf", "+0",  "+inf", "+0",  "+inf","+1","+1" ],
	[ "nan","+0",  "+inf","-0",  "-inf", "+0",  "+inf", "+0",  "+inf","+1","+1" ]];
BinaryTest("pow", powLOps, powROps, results);
