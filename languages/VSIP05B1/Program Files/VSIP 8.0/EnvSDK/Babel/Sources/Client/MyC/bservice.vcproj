	<References>
	</References>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat"
			>
			<File
				RelativePath=".\lexer.lex"
				>
				<FileConfiguration
					Name="Debug|Win32"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Running Flex on $(InputPath)"
						CommandLine="..\tools\flex.exe -o$(InputName).cpp $(InputName).lex&#x0D;&#x0A;"
						Outputs="$(inputname).cpp"
						ExecutionBucket="3"
					/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Running Flex on $(InputPath)"
						CommandLine="..\tools\flex.exe -f -o$(InputName).cpp $(InputName).lex&#x0D;&#x0A;"
						Outputs="$(inputname).cpp"
						ExecutionBucket="3"
					/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\parser.y"
				>
				<FileConfiguration
					Name="Debug|Win32"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Running Bison on $(InputPath)"
						CommandLine="set INIT=..\tools&amp;&amp; ..\tools\bison.exe -v -o$(InputName).cpp -d $(InputName).y&#x0D;&#x0A;"
						Outputs="$(inputname).cpp;$(inputname).cpp.h"
						ExecutionBucket="3"
					/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Running Bison on $(InputPath)"
