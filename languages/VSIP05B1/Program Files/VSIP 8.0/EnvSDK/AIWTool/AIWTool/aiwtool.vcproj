<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="AIWTool"
	ProjectGUID="{8B9A18E6-9935-4E4A-B583-953A31869B26}"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\Debug"
			IntermediateDirectory=".\Debug"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="1"
			>
			<Tool
				Name="VCPreBuildEventTool"
			/>
			<Tool
				Name="VCCustomBuildTool"
				Description="Performing registration"
				CommandLine="echo regsvr32 exec. time &gt; &quot;$(OutDir)\regsvr32.trg&quot;&#x0D;&#x0A;"
				Outputs="$(OutDir)\regsvr32.trg"
			/>
			<Tool
				Name="VCXMLDataGeneratorTool"
				ExecutionBucket="5"
			/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"
				ExecutionBucket="6"
			/>
			<Tool
				Name="VCMIDLTool"
				ExecutionBucket="8"
				AdditionalOptions="-ms_ext -c_ext -no_format_opt"
				PreprocessorDefinitions="DEBUG,UNICODE,_UNICODE,_NEW_SDK=1,_WINDOWS,_USRDLL,i386,_X86_,_WCHAR_T_DEFINED,__MIDL__=1"
				AdditionalIncludeDirectories="..\..\common\idl,..,Debug,..\..\common\inc,..\..\common\tlb"
				WarningLevel="0"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				GenerateStublessProxies="TRUE"
				TypeLibraryName="$(IntDir)\$(InputName).tlb"
				HeaderFileName="$(IntDir)\$(InputName).h"
				DLLDataFileName="$(IntDir)\$(InputName)_d.c"
				InterfaceIdentifierFileName="$(IntDir)\$(InputName)_i.c"
				ProxyFileName="$(IntDir)\$(InputName)_p.c"
				EnableErrorChecks="2"
				StructMemberAlignment="4"
			/>
			<Tool
				Name="VCCLCompilerTool"
				ExecutionBucket="9"
				Optimization="0"
				AdditionalIncludeDirectories=".\,..\..\common\inc,.\Debug"
				PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS;_MBCS;_USRDLL;UNICODE;TLC=2;TLD=2;TLM=2;TLF=3;TLI=4;_X86_=1;i386=1;_NEW_SDK=1;_AFXDLL"
				RuntimeLibrary="3"
				BufferSecurityCheck="TRUE"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="stdafx.h"
				PrecompiledHeaderFile=".\Debug/AIWTool.pch"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"
				BrowseInformation="1"
				WarningLevel="3"
				WarnAsError="TRUE"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="4"
				DisableSpecificWarnings="4996"
			/>
			<Tool
				Name="VCManagedResourceCompilerTool"
				ExecutionBucket="10"
				ResourceFileName=""
			/>
			<Tool
				Name="VCResourceCompilerTool"
				ExecutionBucket="11"
				PreprocessorDefinitions="_DEBUG,UNICODE,_UNICODE,_AFXDLL"
				Culture="1047"
				AdditionalIncludeDirectories="..\..\common\inc;.\Debug"
			/>
			<Tool
				Name="VCPreLinkEventTool"
				ExecutionBucket="12"
			/>
			<Tool
				Name="VCLinkerTool"
				ExecutionBucket="14"
				RegisterOutput="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="VsEnvSdkUtilD.lib vsguids.lib vsassert.lib odbc32.lib odbccp32.lib"
				OutputFile=".\Debug/AIWTool.dll"
				LinkIncremental="2"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="..\..\common\lib\x86\debug"
				ModuleDefinitionFile="..\AIWTool.def"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\Debug/AIWTool.pdb"
				SubSystem="2"
				EntryPointSymbol="_DllMainCRTStartup@12"
				BaseAddress="@..\..\dllbaseEnvSDK.txt,aiwtool"
				ImportLibrary=".\Debug/AIWTool.lib"
			/>
			<Tool
				Name="VCManifestTool"
			/>
			<Tool
				Name="VCXDCMakeTool"
			/>
			<Tool
				Name="VCALinkTool"
				ExecutionBucket="15"
			/>
			<Tool
				Name="VCBscMakeTool"
			/>
			<Tool
				Name="VCAppVerifierTool"
			/>
			<Tool
				Name="VCWebDeploymentTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="if not exist ..\Interop mkdir ..\Interop&#x0D;&#x0A;tlbimp /out:..\Interop\AIWTool.Interop.dll &quot;$(IntDir)\AIWTool.tlb&quot;&#x0D;&#x0A;"
			/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\Release"
			IntermediateDirectory=".\Release"
			ConfigurationType="2"
			UseOfMFC="0"
