			/>
			<Tool
				Name="VCResourceCompilerTool"
				ExecutionBucket="11"
				PreprocessorDefinitions="NDEBUG,UNICODE,_UNICODE,_AFXDLL"
				Culture="1047"
				AdditionalIncludeDirectories="..\..\common\inc;.\Release"
			/>
			<Tool
				Name="VCPreLinkEventTool"
				ExecutionBucket="12"
			/>
			<Tool
				Name="VCLinkerTool"
				ExecutionBucket="14"
				RegisterOutput="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="VsEnvSdkUtil.lib vsguids.lib odbc32.lib odbccp32.lib"
				OutputFile=".\Release/AIWTool.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="..\..\common\lib\x86\retail"
				ModuleDefinitionFile="..\AIWTool.def"
				ProgramDatabaseFile=".\Release/AIWTool.pdb"
				SubSystem="2"
				EntryPointSymbol="_DllMainCRTStartup@12"
				BaseAddress="@..\..\dllbaseEnvSDK.txt,aiwtool"
				ImportLibrary=".\Release/AIWTool.lib"
			/>
			<Tool
				Name="VCManifestTool"
			/>
			<Tool
				Name="VCXDCMakeTool"
			/>
			<Tool
				Name="VCALinkTool"
				ExecutionBucket="15"
			/>
			<Tool
				Name="VCBscMakeTool"
			/>
			<Tool
				Name="VCAppVerifierTool"
			/>
			<Tool
				Name="VCWebDeploymentTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="if not exist ..\Interop mkdir ..\Interop&#x0D;&#x0A;tlbimp /out:..\Interop\AIWTool.Interop.dll &quot;$(IntDir)\AIWTool.tlb&quot;&#x0D;&#x0A;"
			/>
		</Configuration>
