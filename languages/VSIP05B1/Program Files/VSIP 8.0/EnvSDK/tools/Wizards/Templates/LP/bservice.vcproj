<?xml version="1.0" encoding = "Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="%ProjectName%"
	SccProjectName=""
	SccLocalPath="">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\Debug"
			IntermediateDirectory=".\Debug"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="1">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories="%InstallDir%\common\inc;%InstallDir%\babel\common"
				PreprocessorDefinitions="_DEBUG;WIN32;_WINDOWS;UNICODE;_USRDLL;BSERVICE_EXPORTS"
				RuntimeLibrary="1"
				BufferSecurityCheck="TRUE"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"
				WarningLevel="3"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="4"
				DisableSpecificWarnings="4099"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				RegisterOutput="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="common.lib odbc32.lib odbccp32.lib"
				OutputFile=".\Debug/bservice.dll"
				LinkIncremental="2"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="%InstallDir%\common\debug;%InstallDir%\babel\common\Debug"
				ModuleDefinitionFile="%InstallDir%\babel\common\dllmain.def"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\Debug/bservice.pdb"
				EntryPointSymbol="_DllMainCRTStartup@12"
				ImportLibrary=".\Debug/bservice.lib"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="_DEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName=".\Debug/bservice.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="_DEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\Release"
			IntermediateDirectory=".\Release"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="1">
			<Tool
				Name="VCCLCompilerTool"
				InlineFunctionExpansion="1"
				AdditionalIncludeDirectories="%InstallDir%\common\inc;%InstallDir%\babel\common"
				PreprocessorDefinitions="NDEBUG;WIN32;_WINDOWS;UNICODE;_USRDLL;BSERVICE_EXPORTS"
				StringPooling="TRUE"
				RuntimeLibrary="0"
				BufferSecurityCheck="TRUE"
				EnableFunctionLevelLinking="TRUE"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"
				WarningLevel="3"
				SuppressStartupBanner="TRUE"
				DisableSpecificWarnings="4099"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				RegisterOutput="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="common.lib odbc32.lib odbccp32.lib"
				OutputFile=".\Release/bservice.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="%InstallDir%\common\release;%InstallDir%\babel\common\release"
				ModuleDefinitionFile="%InstallDir%\babel\common\dllmain.def"
				ProgramDatabaseFile=".\Release/bservice.pdb"
				EntryPointSymbol="_DllMainCRTStartup@12"
				ImportLibrary=".\Release/bservice.lib"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="NDEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName=".\Release/bservice.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
		</Configuration>
	</Configurations>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;rc;def;r;odl;idl;hpj;bat">
			<File
				RelativePath=".\%LexFileName%">
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCCustomBuildTool"
						Description="Running Flex on $(InputPath)"
						CommandLine='%LexerCommand%'
						Outputs="%LexOutFiles%"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCCustomBuildTool"
						Description="Running Flex on $(InputPath)"
						CommandLine='%LexerCommand%'
						Outputs="%LexOutFiles%"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\%ParserFileName%">
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCCustomBuildTool"
						Description="Running Bison on $(InputPath)"
						CommandLine="%ParserCommand%"
						Outputs="%GramOutFiles%"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCCustomBuildTool"
						Description="Running Bison on $(InputPath)"
						CommandLine="%ParserCommand%"
						Outputs="%GramOutFiles%"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\service.cpp">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath=".\service.h">
			</File>
		</Filter>
		<Filter
			Name="Standard Source Files"
			Filter="cpp">
			<File
				RelativePath="%InstallDir%\babel\common\dllmain.def">
			</File>
			%AdditionalSources%
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
