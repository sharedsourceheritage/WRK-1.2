<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="%ProjectName%"
	SccProjectName=""
	SccLocalPath="">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\Debug"
			IntermediateDirectory=".\Debug"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="1">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories=".\,%InstallDir%\common\idl,%InstallDir%\common\inc\office10,..,Debug,%InstallDir%\common\inc"
				PreprocessorDefinitions="WIN32;_WINDOWS;_MBCS;_USRDLL;UNICODE;TLC=2;TLD=2;TLM=2;TLF=3;TLI=4;_X86_=1;i386=1;_NEW_SDK=1;_AFXDLL"
				RuntimeLibrary="3"
				BufferSecurityCheck="TRUE"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="stdafx.h"
				PrecompiledHeaderFile=".\Debug/%ProjectName%.pch"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"
				BrowseInformation="1"
				WarningLevel="3"
				WarnAsError="TRUE"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="4"
				DisableSpecificWarnings="4099,4996"/>
			<Tool
				Name="VCLinkerTool"
				RegisterOutput="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="vsguids.lib VsEnvSdkUtilD.lib vsassert.lib"
				OutputFile=".\Debug/%ProjectName%.dll"
				LinkIncremental="2"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="%InstallDir%\common\lib\x86\debug"
				ModuleDefinitionFile=".\%ProjectName%.def"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\Debug/%ProjectName%.pdb"
				SubSystem="2"
				EntryPointSymbol="_DllMainCRTStartup@12"
				BaseAddress=""
				ImportLibrary=".\Debug/%ProjectName%.lib"/>
			<Tool
				Name="VCMIDLTool"
				AdditionalOptions="-ms_ext -c_ext -no_format_opt"
				PreprocessorDefinitions="DEBUG,UNICODE,_UNICODE,_NEW_SDK=1,_WINDOWS,_USRDLL,i386,_X86_,_WCHAR_T_DEFINED,__MIDL__=1"
				AdditionalIncludeDirectories="%InstallDir%\common\idl,..,Debug,%InstallDir%\common\inc,%InstallDir%\common\tlb"
				WarningLevel="0"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				GenerateStublessProxies="TRUE"
				TypeLibraryName="$(IntDir)\$(InputName).tlb"
				HeaderFileName="$(IntDir)\$(InputName).h"
				DLLDataFileName="$(IntDir)\$(InputName)_d.c"
				InterfaceIdentifierFileName="$(IntDir)\$(InputName).c"
				ProxyFileName="$(IntDir)\$(InputName)_p.c"
				EnableErrorChecks="2"
				StructMemberAlignment="4"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="regsvr32 /s .\Debug\%ProjectName%.dll"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="_DEBUG,UNICODE,_UNICODE,_AFXDLL"
				Culture="1033"
				AdditionalIncludeDirectories="%InstallDir%\common\inc;.\Debug"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\Release"
			IntermediateDirectory=".\Release"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="1">
			<Tool
				Name="VCCLCompilerTool"
				AdditionalOptions="/Oxs"
				Optimization="4"
				InlineFunctionExpansion="1"
				AdditionalIncludeDirectories=".,%InstallDir%\common\idl,%InstallDir%\common\inc\office10,..,Release,%InstallDir%\common\inc"
				PreprocessorDefinitions="WIN32;_WINDOWS;_MBCS;_USRDLL;UNICODE;NDEBUG;TLC=2;TLD=2;TLM=2;TLF=3;TLI=4;_X86_=1;i386=1;_NEW_SDK=1;_AFXDLL"
				StringPooling="TRUE"
				RuntimeLibrary="2"
				BufferSecurityCheck="TRUE"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="stdafx.h"
				PrecompiledHeaderFile=".\Release/%ProjectName%.pch"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"
				WarningLevel="3"
				WarnAsError="TRUE"
				SuppressStartupBanner="TRUE"
				DisableSpecificWarnings="4099,4996"/>
			<Tool
				Name="VCLinkerTool"
				RegisterOutput="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="vsguids.lib VsEnvSdkUtil.lib msvcrt.lib"
				OutputFile=".\Release/%ProjectName%.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="%InstallDir%\common\lib\x86\retail"
				ModuleDefinitionFile=".\%ProjectName%.def"
				ProgramDatabaseFile=".\Release/%ProjectName%.pdb"
				SubSystem="2"
				EntryPointSymbol="_DllMainCRTStartup@12"
				BaseAddress=""
				ImportLibrary=".\Release/%ProjectName%.lib"/>
			<Tool
				Name="VCMIDLTool"
				AdditionalOptions="-ms_ext -c_ext -no_format_opt"
				PreprocessorDefinitions="NDEBUG,_ATL_STATIC_REGISTRY,_ATL_MIN_CRT,UNICODE,_UNICODE,_NEW_SDK=1,_WINDOWS,_USRDLL,i386,_X86_,_WCHAR_T_DEFINED,__MIDL__=1"
				AdditionalIncludeDirectories="%InstallDir%\common\idl,..,Release,%InstallDir%\common\inc,%InstallDir%\common\tlb"
				WarningLevel="0"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				GenerateStublessProxies="TRUE"
				TypeLibraryName="$(IntDir)\$(InputName).tlb"
				HeaderFileName="$(IntDir)\$(InputName).h"
				DLLDataFileName="$(IntDir)\$(InputName)_d.c"
				InterfaceIdentifierFileName="$(IntDir)\$(InputName).c"
				ProxyFileName="$(IntDir)\$(InputName)_p.c"
				EnableErrorChecks="2"
				StructMemberAlignment="4"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="regsvr32 /s .\Release\%ProjectName%.dll"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG,UNICODE,_UNICODE,_AFXDLL"
				Culture="1033"
				AdditionalIncludeDirectories="%InstallDir%\common\inc;.\Release"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<Filter
			Name="Interface Definition Files"
			Filter="idl;odl">
			<File
				RelativePath=".\%ProjectName%.idl">
			</File>
		</Filter>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;def">
			<File
				RelativePath=".\DLLEntry.cpp">
			</File>
			<File
				RelativePath=".\Guids.cpp">
			</File>
			<File
				RelativePath=".\StdAfx.cpp">
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCCLCompilerTool"
						UsePrecompiledHeader="1"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCCLCompilerTool"
						UsePrecompiledHeader="1"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\%ProjectName%.def">
			</File>
			<File
				RelativePath=".\VsModule.cpp">
			</File>
			<File
				RelativePath=".\VsPkg.cpp">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath=".\PrjInc.h">
			</File>
			<File
				RelativePath=".\Resource.h">
			</File>
			<File
				RelativePath=".\StdAfx.h">
			</File>
			<File
				RelativePath=".\VsModule.h">
			</File>
			<File
				RelativePath=".\VsPkg.h">
			</File>
		</Filter>
		<Filter
			Name="Resource Files"
			Filter="ico;cur;bmp;dlg;rc2;rct;bin;rgs;gif;jpg;jpeg;jpe">
			<File
				RelativePath=".\%ProjectName%.rc">
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCResourceCompilerTool"
						AdditionalIncludeDirectories="%InstallDir%\common\inc;.\Debug;$(OUTDIR);$(NoInherit)"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCResourceCompilerTool"
						AdditionalIncludeDirectories="%InstallDir%\common\inc;.\Release;$(OUTDIR);$(NoInherit)"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\res\VsPkg.rgs">
			</File>
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
