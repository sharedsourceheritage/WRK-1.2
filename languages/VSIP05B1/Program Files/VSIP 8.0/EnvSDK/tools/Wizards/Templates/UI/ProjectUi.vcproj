<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8.00"
	Name="%ProjectName%UI"
	SccProjectName=""
	SccLocalPath="">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\..\%ProjectName%\Debug\1033"
			IntermediateDirectory=".\Debug"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				RuntimeLibrary="5"
				BufferSecurityCheck="TRUE"
				PrecompiledHeaderFile=".\Debug/%ProjectName%UI.pch"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				IgnoreImportLibrary="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies=""
				OutputFile=".\..\%ProjectName%\Debug\1033/%ProjectName%UI.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\..\%ProjectName%\Debug\1033/%ProjectName%UI.pdb"
				ResourceOnlyDLL="TRUE"
				BaseAddress=""
				ImportLibrary=""/>
			<Tool
				Name="VCMIDLTool"
				TypeLibraryName=".\..\%ProjectName%\Debug\1033/%ProjectName%UI.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="devenv /rootsuffix Exp /setup"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				AdditionalOptions="-r "
				PreprocessorDefinitions="UNICODE,_UNICODE,_X86_=1,i386=1,WIN32,WINNT=1,_DEBUG,DEBUG,_NEW_SDK=1"
				Culture="1033"
				AdditionalIncludeDirectories="%InstallDir%\common\inc;.\Debug"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\..\%ProjectName%\Release\1033"
			IntermediateDirectory=".\Release"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				RuntimeLibrary="4"
				BufferSecurityCheck="TRUE"
				PrecompiledHeaderFile=".\Release/%ProjectName%UI.pch"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				IgnoreImportLibrary="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies=""
				OutputFile=".\..\%ProjectName%\Release\1033/%ProjectName%UI.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				ProgramDatabaseFile=".\..\%ProjectName%\Release\1033/%ProjectName%UI.pdb"
				ResourceOnlyDLL="TRUE"
				BaseAddress=""
				ImportLibrary=""/>
			<Tool
				Name="VCMIDLTool"
				TypeLibraryName=".\..\%ProjectName%\Release\1033/%ProjectName%UI.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"
				CommandLine="devenv /rootsuffix Exp /setup"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				AdditionalOptions="-r "
				PreprocessorDefinitions="UNICODE,_UNICODE,_X86_=1,i386=1,WIN32,WINNT=1,NDEBUG,_NEW_SDK=1"
				Culture="1033"
				AdditionalIncludeDirectories="%InstallDir%\common\inc;.\Release"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath=".\Guids.h">
			</File>
			<File
				RelativePath=".\PkgCmdID.h">
			</File>
			<File
				RelativePath=".\Resource.h">
			</File>
		</Filter>
		<Filter
			Name="Resource Files"
			Filter="rc;ico;cur;bmp;dlg;rc2;rct;bin;rgs;gif;jpg;jpeg;jpe">
			<File
				RelativePath=".\PkgCmd.ctc">
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCCustomBuildTool"
						CommandLine="&quot;%InstallDir%\tools\bin\x86\ctc&quot; -nologo .\pkgcmd.ctc Debug\pkgcmd.cto -Ccl -I%InstallDirShort%\common\inc -I%InstallDirShort%\common\inc\office10"
						Outputs="Debug\pkgcmd.cto"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCCustomBuildTool"
						CommandLine="&quot;%InstallDir%\tools\bin\x86\ctc&quot; -nologo .\pkgcmd.ctc Release\pkgcmd.cto -Ccl -I%InstallDirShort%\common\inc -I%InstallDirShort%\common\inc\office10"
						Outputs="Release\pkgcmd.cto"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\%ProjectName%UI.rc">
			</File>
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
