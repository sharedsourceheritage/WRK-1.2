<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.10"
	Name="RDTViewUI"
	SccProjectName=""
	SccLocalPath="">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\..\RDTView\Debug\1033"
			IntermediateDirectory=".\Debug"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				RuntimeLibrary="5"
				BufferSecurityCheck="TRUE"
				PrecompiledHeaderFile=".\Debug/RDTViewUI.pch"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				IgnoreImportLibrary="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="odbc32.lib odbccp32.lib"
				OutputFile=".\..\RDTView\Debug\1033/RDTViewUI.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\..\RDTView\Debug\1033/RDTViewUI.pdb"
				ResourceOnlyDLL="TRUE"
				ImportLibrary=".\..\RDTView\Debug\1033/RDTViewUI.lib"/>
			<Tool
				Name="VCMIDLTool"
				TypeLibraryName=".\..\RDTView\Debug\1033/RDTViewUI.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				AdditionalOptions="-r "
				PreprocessorDefinitions="UNICODE,_UNICODE,_X86_=1,i386=1,WIN32,WINNT=1,_DEBUG,DEBUG,_NEW_SDK=1,VSBLDENV"
				Culture="1033"
				AdditionalIncludeDirectories="..\..\..\..\common\inc;.\Debug"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\..\RDTView\Release\1033"
			IntermediateDirectory=".\Release"
			ConfigurationType="2"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				RuntimeLibrary="4"
				BufferSecurityCheck="TRUE"
				PrecompiledHeaderFile=".\Release/RDTViewUI.pch"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				IgnoreImportLibrary="TRUE"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="odbc32.lib odbccp32.lib"
				OutputFile=".\..\RDTView\Release\1033/RDTViewUI.dll"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				ProgramDatabaseFile=".\..\RDTView\Release\1033/RDTViewUI.pdb"
				ResourceOnlyDLL="TRUE"
				ImportLibrary=".\..\RDTView\Release\1033/RDTViewUI.lib"/>
			<Tool
				Name="VCMIDLTool"
				TypeLibraryName=".\..\RDTView\Release\1033/RDTViewUI.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				AdditionalOptions="-r "
				PreprocessorDefinitions="UNICODE,_UNICODE,_X86_=1,i386=1,WIN32,WINNT=1,NDEBUG,_NEW_SDK=1,VSBLDENV"
				Culture="1033"
				AdditionalIncludeDirectories="..\..\..\..\common\inc;.\Release"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl">
			<File
				RelativePath=".\PkgCmdID.h">
			</File>
			<File
				RelativePath=".\Resource.h">
			</File>
		</Filter>
		<Filter
			Name="Resource Files"
			Filter="rc;ico;cur;bmp;dlg;rc2;rct;bin;rgs;gif;jpg;jpeg;jpe">
			<File
				RelativePath=".\PkgCmd.ctc">
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCCustomBuildTool"
						CommandLine="..\..\..\bin\x86\ctc -nologo .\pkgcmd.ctc Debug\pkgcmd.cto -Ccl -I..\..\..\..\common\inc -I..\..\..\..\common\inc\office10
"
						Outputs="Debug\pkgcmd.cto"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCCustomBuildTool"
						CommandLine="..\..\..\bin\x86\ctc -nologo .\pkgcmd.ctc Release\pkgcmd.cto -Ccl -I..\..\..\..\common\inc -I..\..\..\..\common\inc\office10
"
						Outputs="Release\pkgcmd.cto"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\RDTViewUI.rc">
			</File>
		</Filter>
		<File
			RelativePath=".\PkgCmd.cto">
		</File>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
