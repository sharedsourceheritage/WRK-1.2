    {
        val {D5CCCF20-A7F6-4569-AA9E-845ED57FBB74} = s ', 1000, 1'
    }
    NoRemove ToolWindows
    {
        {C1AE19B0-8DC9-47db-9D18-9EB1887570E3} = s '{D5CCCF20-A7F6-4569-AA9E-845ED57FBB74}'
