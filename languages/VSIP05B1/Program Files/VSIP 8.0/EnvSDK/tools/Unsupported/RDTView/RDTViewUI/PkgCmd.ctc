// Package Command Bar Definition
//

#include "stdidcmd.h"
#include "vsshlids.h"
#include "msobtnid.h"
#include "virtkeys.h"
#include "PkgCmdID.h"
#include "Resource.h"

#define _CTC_GUIDS_
#include "..\Guids.h"
    // defines the following guid
    // guidRDTViewPkg - CommandBar Package Guid
    // guidRDTViewMenuGrp - CommandBar Command Group Guid
    // guidRDTViewCmdSet - CommandBar Command Guid


CMDS_SECTION guidRDTViewPkg

    MENUS_BEGIN
    	// NewMenu                      Relative to Group                       Priority    Type        Name                    Text
    MENUS_END

    NEWGROUPS_BEGIN
        // NewGroup                     Parent Group                            Priority
    NEWGROUPS_END

    BUTTONS_BEGIN
        // Button/Menu Item                Item Group                           Priority Icon                          Type    Flags                                                   Text
		guidRDTViewCmdSet:icmdViewRDTViewer,	guidSHLMainMenu:IDG_VS_WNDO_WINDOWS2,	0x0100,		guidOfficeIcon:msotcidNoIcon,	BUTTON,	     ,	"RDT Viewer";
    BUTTONS_END

    BITMAPS_BEGIN
        // Bitmap                          Bitmap Index, Bitmap Index ...
    BITMAPS_END

CMDS_END

CMDPLACEMENT_SECTION
    // Command                             Group                                Priority
CMDPLACEMENT_END

VISIBILITY_SECTION
    // Command                             GUID when visible
VISIBILITY_END

KEYBINDINGS_SECTION
    // Command                             when available   emulation    keystate
KEYBINDINGS_END
