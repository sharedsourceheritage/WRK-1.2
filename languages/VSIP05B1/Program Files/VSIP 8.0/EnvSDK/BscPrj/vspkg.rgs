HKCR
{
    '.bscp' = s 'VisualStudio.bscp.%PROGID_VERSION%'
    {
        val 'Content Type' = s 'text/plain'
        'OpenWithList'
        {
            'devenv.exe'
            {
            }
        }
        'OpenWithProgids'
        {
            val 'VisualStudio.bscp.%PROGID_VERSION%' = s ''
            val 'BscPrjFile' = s ''
        }
    }
    VisualStudio.bscp.%PROGID_VERSION% = s 'Basic Project File'
    {
        DefaultIcon = s '%MODULE%,-206'
        shell
        {
            open
            {
                command = s '"%DEVENV_PATH%" "%%1"'
            }
        }
    }
}

HKLM
{
    %REGROOTBEGIN%
    NoRemove Packages
    {
        %CLSID_Package% = s 'BscPrj Project Package'
        {
            val InprocServer32 = s '%MODULE%'

            val CompanyName = s 'Microsoft'
            val ProductName = s 'Basic Project Sample'
            val ProductVersion  = s '8.0'
            val MinEdition  = s 'professional'
            val ID  = d '%IDS_PACKAGE_LOAD_KEY%' 

            SatelliteDll
            {
                val DllName = s '%RESOURCE_DLL%'
                val Path = s '%RESOURCE_PATH%'
            }
            Automation
            {
                val %AutomationProjects% = s ''
            }
            AutomationEvents
            {
                val %AutomationProjectsEvents% = s 'Returns the BscProjectsEvents Object'
                val %AutomationProjectItemsEvents% = s 'Returns the BscProjectItemsEvents Object'
            }
        }
    }
    NoRemove Projects
    {
        %GUID_MyProjectType% = s 'BscPrj Project'
        {
            val DisplayName = s '#%IDS_PROJECT_TYPE%'
            val Package = s '%CLSID_Package%'
            val ProjectTemplatesDir = s '%TEMPLATE_PATH%BscPrjProjects'
            val ItemTemplatesDir    = s '%TEMPLATE_PATH%BscPrjProjectItems'
            val DisplayProjectFileExtensions = s '#%IDS_DISPLAY_PROJ_FILE_EXT%'
            val PossibleProjectExtensions = s 'bscp'
            val DefaultProjectExtension = s '.bscp'
            Filters
            {
                1 = s '#%IDS_OPENFILES_FILTER%'
                {
                    val CommonOpenFilesFilter = d 0
                    val CommonFindFilesFilter = d 0
                    val NotAddExistingItemFilter = d 0
                    val FindInFilesFilter = d 0
                    val NotOpenFileFilter = d 0
                    val NotOpenFileFilter = d 0
                    val SortPriority = d 1000
                }
                2 = s '#%IDS_FINDFILES_FILTER%'
                {
                    val CommonOpenFilesFilter = d 0
                    val CommonFindFilesFilter = d 0
                    val NotAddExistingItemFilter = d 1
                    val FindInFilesFilter = d 1
                    val NotOpenFileFilter = d 1
                    val SortPriority = d 1000
                }
            }
            AddItemTemplates
            {
                TemplateDirs
                {
                    %CLSID_Package%
                    {
                        1 = s '#%IDS_ADDITEM_TEMPLATES_ENTRY%'
                        {
                            %CLSID_Package%
                            {
                                1 = s '#%IDS_NEWPROJ_TEMPLATES_ENTRY%'
                                {
                                    val Folder = s '%GUID_VsNewProjectPseudoFolder%'
                                    val TemplatesDir = s '%TEMPLATE_PATH%BscPrjProjects'
                                    val SortPriority = d 1000
                                }
                            }
                            val TemplatesDir = s '%TEMPLATE_PATH%BscPrjProjectItems'
                            val SortPriority = d 100
                        }
                    }

                }
            }
        }
        NoRemove '%GUID_EFProjectType%'
        {
            NoRemove AddItemTemplates
            {
                NoRemove TemplateDirs
                {
                    %CLSID_Package%
                    {
                        1 = s '#%IDS_NEWPROJ_TEMPLATES_ENTRY%'
                        {
                            val TemplatesDir = s '%TEMPLATE_PATH%BscPrjProjects'
                            val SortPriority = d 1000
                            val NewProjectDialogOnly = d '0'
                        }
                    }
                }
            }
        }
    }
    NoRemove Menus
    {
        val %CLSID_Package% = s ',1000,1'
    }
    NoRemove NewProjectTemplates
    {
        NoRemove PseudoFolders
        {
            NoRemove %GUID_VsNewProjectPseudoFolder%
            {
                val DisplayName = s '#13016'
                val Package = s '%CLSID_VsEnvironmentPackage%'
                val SortPriority = d 900
            }
        }
        NoRemove TemplateDirs
        {
            %CLSID_Package%
            {
                1 = s '#%IDS_NEWPROJ_TEMPLATES_ENTRY%'
                {
                    val Folder = s '%GUID_VsNewProjectPseudoFolder%'
                    val TemplatesDir = s '%TEMPLATE_PATH%BscPrjProjects'
                    val SortPriority = d 1000
                    val NewProjectDialogOnly = d '0'
                }
            }
        }
    }
    NoRemove InstalledProducts
    {
        'BasicProjectSample' = s #%IDS_OFFICIALNAME%
        {
            val Package = s '%CLSID_Package%'
            val ProductDetails = s #%IDS_PRODUCTDETAILS%
            val LogoID = s '#0'
            val PID = s '7.1'
            val UseInterface = d '0'
        }
    }
    
    NoRemove Extenders
    {
	    %CATID_ProjectBrowseObject%
	    {
			'VSPolicyExtenderProvider' = s '{2AA841FA-72CF-493d-BD95-81E46540BEC8}'
	    }
    }

    NoRemove Policy
    {
        NoRemove TargetCATIDs
        {
		    %CATID_ProjectBrowseObject% = s 'BscPrj ProjectBrowseObject'
		    %CATID_FileBrowseObject% = s 'BscPrj FileBrowseObject'
        }
    }
        
    %REGROOTEND%
}
