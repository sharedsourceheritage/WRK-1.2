#ifndef PKG_CTC
#define PKG_CTC

#include "stdidcmd.h"	    // Shell specified commands
#include "vsshlids.h"	    // Shell specified groups/guids
#include "msobtnid.h"	    // Shell specified commands
#include "pkgicmd.h"

// This value must match CLSID_MyPackage defined in '<project>id.h'
#define guidMyPkg { 0xE59935A1, 0x6156, 0x11d1, { 0x87, 0xA6, 0x00, 0xA0, 0xC9, 0x1E, 0x2A, 0x46 } }

//////////////////////////////////////////////////////////////////////////////
//
// Within the project we are using the standard context menus defined in
// src\appid\inc\SharedCmdPlace.ctc. Please examine that file for full
// details. 
// Note that it is allowable to add package specific menus, groups 
// or commands to existing standard groups. Any such package specific
// menu data will appear in the sections below.
//
//////////////////////////////////////////////////////////////////////////////
CMDS_SECTION guidMyPkg
  MENUS_BEGIN
    // GUID:MENUID								PARENT GROUP		PRIORITY	TYPE		BUTTONTEXT			MENUTEXT		    TOOLTIPTEXT	      COMMANDTEXT
    //----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------			
  MENUS_END

  NEWGROUPS_BEGIN
    // GUID:GROUPID							PARENT MENU								PRIORITY  FLAG
    //-------------------------------------------------------------------------------------------
  NEWGROUPS_END	

  BUTTONS_BEGIN
   // GUID:CMDID							PARENT MENU								PRIORITY	ICON							TYPE	FLAGS	BUTTON TEXT
   //-------------------------------------------------------------------------------------------
  BUTTONS_END
CMDS_END

//////////////////////////////////////////////////////////////////////////////
// CMDPLACEMENT_SECTION
// 
// This sections defines where the commands will be placed if not just in 
// their primary groups.
//
//////////////////////////////////////////////////////////////////////////////

CMDPLACEMENT_SECTION
   // GUID:GROUPID									PARENT MENU								PRIORITY 
   //-----------------------------------------------------------------------------------------------

CMDPLACEMENT_END


//////////////////////////////////////////////////////////////////////////////
// KEYBINDINGS_SECTION
// 
// This sections defines the keystroke mappings for the commands.
//
// The Keystate field is done using the following:
//    A = Alt, S = Shift, C = Control, W = Windows Key
//
// Example of the Keystate assignment, if you want a two key combination
// of Ctrl-X, Ctrl-Shift-C then the syntax would be :
//
//	'x':C:'c':CS
//
//////////////////////////////////////////////////////////////////////////////

KEYBINDINGS_SECTION
  // GUID:CMDID				    EDITORGUID		      EMULATIONGUID		KEYSTATE
  

KEYBINDINGS_END


#endif // PKG_CTC
