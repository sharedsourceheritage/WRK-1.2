END

IDD_PP_LAUNCH DIALOG  0, 0, 250, 150
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Tahoma"
BEGIN
    LTEXT           "When project is run, launch the program (command line to program):",
                    IDC_STATIC,7,7,220,8
    EDITTEXT        IDC_LAUNCHPRG,17,18,226,14,ES_AUTOHSCROLL
    LTEXT           "Send these command line arguments to launched program:",
                    IDC_STATIC,7,41,236,8
