    LTEXT           "<Message text goes here>",IDC_MSGTEXT,38,7,227,26,
                    SS_NOPREFIX
    CONTROL         "&Apply to all items",IDC_CHK_APPLYTOALL,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,38,41,227,10
    DEFPUSHBUTTON   "&Yes",IDYES,107,61,50,14
    PUSHBUTTON      "&No",IDNO,161,61,50,14
