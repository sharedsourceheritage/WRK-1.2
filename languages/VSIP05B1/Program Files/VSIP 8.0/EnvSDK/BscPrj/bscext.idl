// BscExt.idl : IDL source for BasicProject Project Extensibility

import "oaidl.idl";
import "ocidl.idl";
import "vsshell.idl";
import "vsshell2.idl";
import "vsshell80.idl";
cpp_quote("#include \"oleipc.h\"")

[
    uuid(F255F830-50C6-11D2-9EDC-000000000000),
    version(1.0),
    helpstring("BscPrj Extensibility")
]

library BscPrjExtLib
{
    importlib("stdole32.tlb");
    importlib("stdole2.tlb");
    importlib("DTE.tlb");


    //---------------------------------------------------------------------
    // Constants
    //---------------------------------------------------------------------
    [ uuid(76F2B62F-00C3-11d2-B349-00C04FB6C6FF) ] 
    module BscConstants 
    {
        // Automation Project(s) Item(s) Kinds.

        [helpstring("Projects automation object kind")]          
        const LPSTR prjKindBscPrjProjects        = "{EBAB368D-00C2-11d2-B349-00C04FB6C6FF}";

        [helpstring("Project automation object kind")]          
        const LPSTR prjKindBscPrjProject         = "{EBAB3690-00C2-11d2-B349-00C04FB6C6FF}";

        [helpstring("ProjectItems automation object kind")]          
        const LPSTR prjKindBscPrjProjectItems    = "{EBAB3692-00C2-11d2-B349-00C04FB6C6FF}";
        
        [helpstring("BscPrj Project automation object CATID")]     
        const LPSTR prjCATIDBscPrjProject          = "{610d4617-d0d5-11d2-8599-006097c68e81}";

        [helpstring("BscPrj ProjectItem automation object CATID")]     
        const LPSTR prjCATIDBscPrjProjectItem      = "{610d4618-d0d5-11d2-8599-006097c68e81}";
    }


    //---------------------------------------------------------------------
    // Events Root interface. Needs to be in the type lib since the 
    //  properties need to be called thru Invoke. 
    //---------------------------------------------------------------------
    [ uuid(4B242740-3167-11d2-8DB1-00C04FB6C6FF), dual, object, hidden]
    interface IBscEventsRoot : IDispatch
    {
        [id(1), propget] HRESULT _stdcall BscProjectsEvents([out, retval] IDispatch** ppdisp);
        [id(2), propget] HRESULT _stdcall BscProjectItemsEvents([in, optional, defaultvalue(0)] IDispatch* Filter, [out, retval] IDispatch** ppdisp);
    };


    //---------------------------------------------------------------------
    // Project specific objects
    //---------------------------------------------------------------------
    // BscProject
    [ uuid(EBAB3690-00C2-11d2-B349-00C04FB6C6FF), dual, object ]
    interface BscProject : IDispatch
    {
    };

    // BscProjectItem 
    [ uuid(76F2B62B-00C3-11d2-B349-00C04FB6C6FF), dual, object ]
    interface BscProjectItem : IDispatch
    {
    };

};