         document.write('<a href="mailto:qswish@microsoft.com?subject=QuickStart v2.0 Feedback: ' + document.URL + '">Send Comments on this topic</a>')
        </SCRIPT>
      </div>
    </center>
    <br />
    <br />

</asp:Content>

