<%@ Master Language="VB" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
  <title>Menu SiteMapDataSource Sample</title>
</head>
<body>
  <form id="form1" runat="server">
    <div>
      <h2>
        Menu and SiteMapDataSource Sample</h2>
      This sample contains two menus that use the same Navigation provider data. Each
      example has configured which levels of data it is retrieving and which levels of
      data it is displaying. Navigate through the example and notice the different 
      rendering.
      <br />
      <br />
      <table style="vertical-align: top; text-align: justify" cellpadding="8" 
        width="90%">
        <tr>
          <td bgcolor="#ccffff" valign="top">
            <b>Note:</b><br />
            Menu.StaticDisplayLevels=1<br />
            DataSource.ShowStartingNode="false"<br />
            <br />
            <asp:Menu DataSourceID="SiteMapDataSource1" ID="Menu1" runat="server" 
                BackColor="#B5C7DE" DynamicHorizontalOffset="2" 
                Font-Names="Verdana" ForeColor="#284E98" StaticSubMenuIndent="10px">
              <StaticSelectedStyle BackColor="#507CD1" />
              <StaticMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
              <DynamicMenuStyle BackColor="#B5C7DE" />
              <DynamicSelectedStyle BackColor="#507CD1" />
              <DynamicMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
              <DynamicHoverStyle BackColor="#284E98" Font-Bold="False" 
                ForeColor="White" />
              <StaticHoverStyle BackColor="#284E98" Font-Bold="False" 
                ForeColor="White" />
            </asp:Menu>
            <asp:SiteMapDataSource ID="SiteMapDataSource1" runat="server" 
                ShowStartingNode="False" />
            <br />
            <br />
          </td>
          <td width="10">
          </td>
          <td bgcolor="#ffcc00" bordercolor="#ff3333" rowspan="2">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
              &nbsp;</asp:ContentPlaceHolder>
            &nbsp;</td>
        </tr>
        <tr>
          <td style="width: 241px" bgcolor="#ffffcc" valign="top">
            <b>Note:</b><br />
            Menu.StaticDisplayLevels=2<br />
            DataSource.ShowStartingNode="true"<br />
            <br />
            <br />
            <asp:Menu DataSourceID="SiteMapDataSource2" ID="Menu2" runat="server" 
                StaticDisplayLevels="2" BackColor="#FFFBD6" 
                DynamicHorizontalOffset="2" Font-Names="Verdana" 
                ForeColor="#990000" StaticSubMenuIndent="10px">
              <StaticSelectedStyle BackColor="#FFCC66" />
              <StaticMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
              <DynamicMenuStyle BackColor="#FFFBD6" />
              <DynamicSelectedStyle BackColor="#FFCC66" />
              <DynamicMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
              <DynamicHoverStyle BackColor="#990000" Font-Bold="False" 
                ForeColor="White" />
              <StaticHoverStyle BackColor="#990000" Font-Bold="False" 
                ForeColor="White" />
            </asp:Menu>
            <asp:SiteMapDataSource ID="SiteMapDataSource2" runat="server" />
            <br />
            <br />
          </td>
          <td width="10">
          </td>
        </tr>
      </table>
      <br />
      <br />
    </div>
  </form>
</body>
</html>
