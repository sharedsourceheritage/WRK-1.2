<%@ Master Language="VB" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
  <title>Menu Using an XMLDataSource Control</title>
</head>
<body>
  <form id="form1" runat="server">
    <div>
      <h2>
        Menu Using an XMLDataSource Control</h2>
      In this sample, the Menu control is databound to an XMLDataSource control that 
      retrieves its data from the sitemap.xml. This requires that you databind the 
      XML data to the corresponding MenuItem properties. In this example the XPath 
      property of the XMLDataSource control is used to return all of the nodes below 
      the root for display by the Menu.
      <br />
      <br />
      <table width="100%">
        <tr>
          <td bgcolor="#ffffcc" valign="top">
            <asp:Menu DataSourceID="XmlDataSource1" ID="Menu1" runat="server" 
              BackColor="#FFFBD6" DynamicHorizontalOffset="2" Font-Names="Verdana" 
              ForeColor="#990000" StaticSubMenuIndent="10px">
              <DataBindings>
                <asp:MenuItemBinding DataMember="siteMapNode" 
                  NavigateUrlField="url" TextField="title" ToolTipField="description" 
                  ValueField="title" />
              </DataBindings>
              <StaticSelectedStyle BackColor="#FFCC66" />
              <StaticMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
              <DynamicMenuStyle BackColor="#FFFBD6" />
              <DynamicSelectedStyle BackColor="#FFCC66" />
              <DynamicMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
              <DynamicHoverStyle BackColor="#990000" Font-Bold="False" 
                ForeColor="White" />
              <StaticHoverStyle BackColor="#990000" Font-Bold="False" ForeColor="White" />
            </asp:Menu>
            <asp:XmlDataSource DataFile="~/App_Data/sitemap.xml" 
              ID="XmlDataSource1" runat="server" XPath="/*/*"></asp:XmlDataSource>
          </td>
          <td width="10">
          </td>
          <td bgcolor="#ffcc33" valign="top">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
              &nbsp;</asp:ContentPlaceHolder>
          </td>
        </tr>
      </table>
      <br />
      &nbsp;<br />
      &nbsp;
    </div>
  </form>
</body>
</html>
