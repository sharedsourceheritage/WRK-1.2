
           
            <asp:TreeView NodeIndent="7" runat="server">
              <LevelStyles>
                <asp:TreeNodeStyle Font-Size="Small" ImageUrl="~/Images/OpenBook.gif" Font-Bold="True" />
                <asp:TreeNodeStyle ImageUrl="~/Images/Folder.gif" />
                <asp:TreeNodeStyle Font-Italic="true" ImageUrl="~/Images/File.gif" HorizontalPadding="10" />
                <asp:TreeNodeStyle Font-Italic="true" ImageUrl="~/Images/Bullet_Nav_Big.gif" />
              </LevelStyles>
              <SelectedNodeStyle Font-Underline="False" />
              <NodeStyle ChildNodesPadding="10" HorizontalPadding="5" ForeColor="green" Font-Size="x-small" />
            </asp:TreeView>