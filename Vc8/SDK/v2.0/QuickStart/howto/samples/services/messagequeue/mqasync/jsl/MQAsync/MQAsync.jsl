import System.*;
import System.Messaging.*;
import System.Threading.*;

public class MQReceive
{
    public static void main(String[] args)
    {
        String appName = Environment.GetCommandLineArgs()[0];

        if (args.get_Length() != 1) {
            Console.WriteLine("Usage: {0} <queue>", appName);
            return;
        }

        String mqPath = ".\\" + args[0];

        if (!(MessageQueue.Exists(mqPath))) {
            Console.WriteLine("The queue '{0}' does not exist!", mqPath);
        }
        else {
            MessageQueue mq = new MessageQueue(mqPath);

            ((XmlMessageFormatter)(mq.get_Formatter())).set_TargetTypeNames(new
                String[] { "String,mscorlib" });
            mq.add_ReceiveCompleted(new ReceiveCompletedEventHandler(
                OnReceiveCompleted));
            mq.BeginReceive();
        }

        Console.WriteLine("Press Enter to quit the sample");
        Console.ReadLine();
    } //main

    private static void OnReceiveCompleted(Object source,
        ReceiveCompletedEventArgs asyncResult)
    {
        MessageQueue mq = (MessageQueue)source;
        Message m = mq.EndReceive(asyncResult.get_AsyncResult());

        m.set_Formatter(new XmlMessageFormatter(new String[] { "String,"
            + "mscorlib" }));
        Console.WriteLine("Message: {0}", (String)(m.get_Body()));
        mq.BeginReceive();
    } //OnReceiveCompleted
} //MQReceive