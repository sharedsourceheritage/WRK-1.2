import System.*;
import System.Messaging.*;

public class Formatters
{
    public static void main(String[] args)
    {
        String mqPath = ".\\FormattersSample";

        if (!(MessageQueue.Exists(mqPath))) {
            MessageQueue.Create(mqPath);
        }

        MessageQueue mq = new MessageQueue(mqPath);
        Order order = new Order();

        order.set_OrderId(102);
        order.set_ItemDescription("MS Visual Studio 7");
        mq.set_Formatter(new XmlMessageFormatter());
        mq.Send(order);
        mq.set_Formatter(new BinaryMessageFormatter());
        mq.Send(order);
        mq.set_Formatter(new ActiveXMessageFormatter());
        mq.Send((Int32)10);
    } //main
} //Formatters