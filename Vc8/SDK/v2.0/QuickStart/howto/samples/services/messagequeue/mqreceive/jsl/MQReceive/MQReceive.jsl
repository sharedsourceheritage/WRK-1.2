import System.*;
import System.Messaging.*;
import System.IO.*;
import System.Runtime.Serialization.*;

public class MQReceive
{
    public static void main(String[] args)
    {
        String appName = Environment.GetCommandLineArgs()[0];

        if (args.get_Length() != 1) {
            Console.WriteLine("Usage: {0} <queue>", appName);
        }
        else {
            String mqPath = ".\\" + args[0];
            if (!(MessageQueue.Exists(mqPath))) {
                Console.WriteLine("The queue '{0}' does not exist!", mqPath);
                return;
            }
            MessageQueue mq = new MessageQueue(mqPath);
            ((XmlMessageFormatter)(mq.get_Formatter())).
                set_TargetTypeNames(new String[] { "System.String,mscorlib" });
            try {
                Message m = mq.Receive(new TimeSpan(0, 0, 3));
                Console.WriteLine("Message: {0}", m.get_Body());
            }
            catch (MessageQueueException exp) {
                Console.WriteLine("There are no messages in the queue");
                return;
            }
            catch (InvalidOperationException exp) {
                Console.WriteLine("The message removed from the queue is not "
                    + "a String");
                return;
            }
        }
        Console.WriteLine();
        Console.WriteLine("Press Enter to continue...");
        Console.ReadLine();
    } //main
} //MQReceive