import System.*;

/** @attribute Serializable()
 */
/** @attribute CLSCompliant(false)
 */
public class Order
{
    private long orderId;
    private String itemDescription;

    /** @property 
     */
    public long get_OrderId()
    {
        return this.orderId;
    } //get_OrderId

    /** @property 
     */
    public void set_OrderId(long value)
    {
        this.orderId = value;
    } //set_OrderId

    /** @property 
     */
    public String get_ItemDescription()
    {
        return this.itemDescription;
    } //get_ItemDescription

    /** @property 
     */
    public void set_ItemDescription(String value)
    {
        this.itemDescription = value;
    } //set_ItemDescription
} //Order