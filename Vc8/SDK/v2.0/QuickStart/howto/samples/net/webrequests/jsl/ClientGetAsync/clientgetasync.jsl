import System.*;
import System.Net.*;
import System.Threading.*;
import System.Text.*;
import System.IO.*;
 
// The RequestState class is used to pass data
// across async calls
final class RequestState
{
    private static final int BUFFER_SIZE = 1024;
    private StringBuilder requestData;
    private ubyte buffer[];
    private HttpWebRequest request;
    private HttpWebResponse response;
    private Stream responseStream;

    // Create Decoder for appropriate encoding type
    private Decoder decoder = 
        Encoding.get_UTF8().GetDecoder();

    /** @property 
     */
    public Decoder get_DataDecoder()
    {
        return decoder;
    } //get_DataDecoder

    /** @property 
     */
    public void set_DataDecode(Decoder value)
    {
        decoder = value;
    } //set_DataDecode

    /** @property 
    */
    public HttpWebResponse get_Response()
    {
        return response;
    } //get_Response

    /** @property 
     */
    public void set_Response(HttpWebResponse value)
    {
        response = value;
    } //set_Request

    /** @property 
     */
    public Stream get_ResponseStream()
    {
        return responseStream;
    } //get_ResponseStream

    /** @property 
     */
    public void set_ResponseStream(Stream value)
    {
        responseStream = value;
    } //set_ResponseStream

    /** @property 
     */
    public HttpWebRequest get_Request()
    {
        return request;
    } //get_Request

    /** @property 
     */
    public void set_Request(HttpWebRequest value)
    {
        request = value;
    } //set_Request

    /** @property 
     */
    public ubyte[] get_ReadBuffer()
    {
        return buffer;
    } //get_ReadBuffer

    /** @property 
     */
    public void set_ReadBuffer(ubyte value[])
    {
        buffer = value;
    } //set_ReadBuffer

    /** @property 
     */
    public StringBuilder get_RequestData()
    {
        return requestData;
    } //get_RequestData

    /** @property 
     */
    public void set_RequestData(StringBuilder value)
    {
        requestData = value;
    } //set_RequestData

    public RequestState()
    {
        buffer = new ubyte[BUFFER_SIZE];
        requestData = new StringBuilder("");
    } //RequestState
} //RequestState

// ClientGetAsync issues the async request
 final class ClientGetAsync
 {
    public static ManualResetEvent allDone = new ManualResetEvent(false);
    private static final int BUFFER_SIZE = 1024;

    public static void main(String[] args)
    {
        if (args.get_Length() < 1) {
            ShowUsage();
            return;
        }
        // Get the URI from the command line
        Uri httpSite = new Uri(args[0]);
        // Create the request object
        HttpWebRequest request = (HttpWebRequest)(WebRequest.Create(httpSite));
        // Create the state object
        RequestState state = new RequestState();
        // Add the request into the state so it can be passed around
        state.set_Request(request);
        // Issue the async request
        request.BeginGetResponse(new AsyncCallback(RespCallback), state);
        // Set the ManualResetEvent to Wait so that the app
        // doesn't exit until after the callback is called
        allDone.WaitOne();
    } //main

    public static void ShowUsage()
    {
        Console.WriteLine("Attempts to GET a URL");
        Console.WriteLine("\r\nUsage:");
        Console.WriteLine("ClientGetAsync URL");
        Console.WriteLine("Examples:");
        Console.WriteLine("ClientGetAsync http://www.microsoft.com/net/");
    } //ShowUsage

    private static void RespCallback(IAsyncResult result)
    {
        // Get the RequestState object from the async result
        RequestState state = (RequestState)(result.get_AsyncState());
        // Get the HttpWebRequest from RequestState
        HttpWebRequest request = state.get_Request();
        // Calling EndGetResponse produces the HttpWebResponse object
        // which came from the request issued above
        HttpWebResponse response = null;
        try
        {
            response = (HttpWebResponse)(request.EndGetResponse(result));
            // Now that we have the response, it is time to start reading
            // data from the response stream

            // Add the response to the state object.
            state.set_Response(response);

            Stream responseStream = response.GetResponseStream();
            // The read is also done using async so we'll want
            // to store the stream in RequestState
            state.set_ResponseStream(responseStream);
            // Note that rs.bufferRead is passed in to BeginRead.  This is
            // where the data will be read into.
            responseStream.BeginRead(
                state.get_ReadBuffer(),
                0,
                BUFFER_SIZE,
                new AsyncCallback(ReadCallBack),
                state);
        }
        catch (WebException exp)
        {
            Console.WriteLine("\r\nThe request URI was not found.");
            if (response != null)
                response.Close();
            allDone.Set();
        }
        catch (IOException exp)
        {
            Console.WriteLine("\r\nCould not connect to the requested resource.");
            response.Close();
            allDone.Set();
        }
    } //RespCallback

    private static void ReadCallBack(IAsyncResult result)
    {
        // Get the RequestState object from the asyncresult
        RequestState state = (RequestState)(result.get_AsyncState());
        // Pull out the ResponseStream that was set in RespCallback
        Stream responseStream = state.get_ResponseStream();
        // At this point rs.BufferRead should have some data in it.
        // Read will tell us if there is any data there
        int read = responseStream.EndRead(result);

        if (read > 0) {
            // Prepare char array buffer for converting to Unicode
            char charBuffer[] = new char[BUFFER_SIZE];
            // Convert byte stream to char array and then String
            // length shows how many characters are converted to Unicode
            int length = state.get_DataDecoder().GetChars(
                state.get_ReadBuffer(), 0, read, charBuffer, 0);
            // Append the recently read data to the RequestData Stringbuilder 
            // object contained in RequestState
            state.get_RequestData().Append(new String(charBuffer, 0, length));
            // Now fire off another async call to read some more data
            // Note that this will continue to get called until
            // responseStream.EndRead returns 0.
            try
            {
                responseStream.BeginRead(
                    state.get_ReadBuffer(),
                    0,
                    BUFFER_SIZE,
                    new AsyncCallback(ReadCallBack),
                    state);
            }
            catch (IOException exp)
            {
                Console.WriteLine("\r\nCould not retrieve the requested resource.");
                state.get_Response().Close();
                allDone.Set();
            }
        }
        else {
            // All of the data has been read, so display it to the console
            Console.WriteLine(state.get_RequestData().ToString());
            // Close down the response stream
            responseStream.Close();
            // Set the ManualResetEvent so the main thread can exit
            allDone.Set();
        }
        return;
    } //ReadCallBack
} //ClientGetAsync