			<xsd:attributeGroup ref="commonAttributeGroup" />
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="s" type="simpleInlineElement" />
	<xsd:element name="samp" type="simpleInlineElement" />
	<xsd:element name="script">
		<xsd:complexType mixed="true">
			<xsd:attribute name="Archive" type="xsd:anyURI" />
