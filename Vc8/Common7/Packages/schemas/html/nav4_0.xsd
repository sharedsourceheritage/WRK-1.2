			<xsd:attribute name="Width" />
			<xsd:attributeGroup ref="commonAttributeGroup" />
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="span" type="simpleInlineElement" />
	<xsd:element name="strike" type="simpleInlineElement" />
	<xsd:element name="strong" type="simpleInlineElement" />
	<xsd:element name="style">
		<xsd:complexType mixed="true">
			<xsd:attribute name="Type">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
