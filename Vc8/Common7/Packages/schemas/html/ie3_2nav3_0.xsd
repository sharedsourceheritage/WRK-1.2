			<xsd:attribute name="HRef" type="xsd:anyURI" vs:preferredextensions=".asp;.aspx;.asmx;.asax;.ashx;.asix;.ascx;.htm;.html;.xml;.xsd;.config;.asa;.css;.shtm;.shtml;.php;.jsp" />
			<xsd:attribute name="Name" />
			<xsd:attribute name="Target" type="frameTarget" />

			<xsd:attributeGroup ref="runatAttributeGroup" />
			<xsd:attribute name="onclick" vs:omtype="event" />
			<xsd:attribute name="onmouseover" vs:omtype="event" />
			<xsd:attribute name="OnServerClick" vs:omtype="event" vs:category="ASP.NET" vs:nonfilterable="true" />
		</xsd:complexType>
