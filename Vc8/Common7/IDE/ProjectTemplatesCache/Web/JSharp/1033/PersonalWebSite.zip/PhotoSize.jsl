public class PhotoSize {
	public static final int Small = 1;		// 100px
	public static final int Medium = 2;		// 198px
	public static final int Large = 3;		// 600px
	public static final int Original = 4;	// Original Size

	private int size;

	public PhotoSize(int s) {
		size = s;
	}

	public int get_Size() {
		return size;
	}

	public void set_Size(int s) {
		size = s;
	}
}
